# The vault generator intentionally emits Markdown hard breaks and blank separators.
# Keep these legal in generated notes while retaining all other whitespace checks.
ObsidianFlyVis/**/*.md whitespace=-blank-at-eol,-blank-at-eof

# The diagnostic checks SHA-256 of the actual source and result bytes on Windows.
scripts/*flyvis_pair_support_overlap*20261107.py text eol=lf
runs/flyvis_pair_support_overlap_20261107/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/*flyvis_exclusive_t4t5_20261107.py text eol=lf
scripts/flyvis_five_flip_*_20261107.py text eol=lf
scripts/*flyvis_atlas*_20261107.py text eol=lf
# Keep the upstream OFL license as distributed with the local IBM Plex fonts.
ui/flyvis_atlas/dist/fonts/LICENSE.txt -text whitespace=-blank-at-eol,space-before-tab,cr-at-eol
runs/flyvis_atlas_readout_20261107/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
runs/flyvis_atlas_core_20261107/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
runs/flyvis_exclusive_t4t5_20261107/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

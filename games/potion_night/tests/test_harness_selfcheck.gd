extends RefCounted

## Проверяет сам харнесс. Раннер, который не умеет падать, хуже отсутствующего —
## поэтому шаг «сломать тест намеренно» есть в плане отдельным пунктом.

func run(t: AssertBag) -> void:
	t.eq(2 + 2, 4, "арифметика жива")
	t.check(true, "check пропускает истину")
	t.almost(0.1 + 0.2, 0.3, "almost терпит плавающую точку")

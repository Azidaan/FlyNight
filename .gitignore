# ═══ Данные ═══════════════════════════════════════════
# 109 ГБ, 805 тысяч файлов — качается отдельно
data/

# ═══ Научные результаты — хранить, большие выгрузки — нет ═══
# runs содержит десятки ГиБ покадровых JSON, поэтому не открываем все *.json.
# Каталоги проходим, автоматически разрешаем отчёты и воспроизводимость.
/runs/**
!/runs/**/
!/runs/**/*.md
!/runs/**/*.csv
!/runs/**/*.tsv
!/runs/**/*.yaml
!/runs/**/*.yml
!/runs/**/*.toml
!/runs/**/*summary*.json
!/runs/**/*report*.json
!/runs/**/*protocol*.json
!/runs/**/*config*.json
!/runs/**/*manifest*.json
!/runs/**/*metadata*.json
!/runs/**/*metric*.json
!/runs/**/*reproduction*.json
!/runs/**/*audit*.json
!/runs/**/*contract*.json
!/runs/**/*authorization*.json
!/runs/**/*result*.json
!/runs/**/*recorded*.json
!/runs/**/*criteria*.json
!/runs/**/*decision*.json
!/runs/**/*hash*.json
!/runs/**/*rows*.json
!/runs/**/per_video*.json
!/runs/**/selection*.json
!/runs/**/signatures.json
!/runs/**/done.json
!/runs/**/completed.json
!/runs/**/completed_jobs/*.json
# Прежнее исключение: полные небольшие манифесты замороженного стенда.
!/runs/bench_freeze/*.json
# Встроенные пакеты и компиляционные кэши не являются результатами опыта.
/runs/**/packages/
/runs/**/site-packages/
/runs/**/inductor_cache/
/runs/**/triton_cache/
/runs/**/.cache/


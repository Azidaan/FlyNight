<mxfile host="app.diagrams.net" type="device" agent="claude-code"><diagram name="1. Карта проекта" id="page1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Карта проекта: 11 этапов плана и что из них сделано на самом деле&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t1s" value="Состояние на 25.08.2026. Зелёный — готово, жёлтый — частично или идёт, серый — не начато, оранжевый и фиолетовый — под вопросом." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1400" height="30" as="geometry"/></mxCell><mxCell id="b1" value="ПОДГОТОВКА" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="130" height="158" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Этап 1 — Окружение&lt;/b&gt;&lt;br&gt;ГОТОВО&lt;br&gt;&lt;br&gt;Python 3.10 целиком внутри E:\Dissertation&lt;br&gt;видеокарта RTX 5070, 12 ГБ&lt;br&gt;notes/environment.md&lt;br&gt;smoke_test_yolo.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="120" width="280" height="158" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Этап 2 — Данные&lt;/b&gt;&lt;br&gt;ГОТОВО&lt;br&gt;&lt;br&gt;BDD100K MOT, train и val, переведён в формат YOLO&lt;br&gt;четыре поднабора: night, rain, fog, normal&lt;br&gt;notes/bdd100k_data_summary.md&lt;br&gt;notes/subset_definitions.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="498" y="120" width="280" height="158" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Этап 3 — Baseline YOLO&lt;/b&gt;&lt;br&gt;ГОТОВО — это точка отсчёта&lt;br&gt;&lt;br&gt;100 эпох, 3 сида, пик: 0.4407 ± 0.0007&lt;br&gt;12 эпох, 3 сида, итог: 0.4254 ± 0.0144&lt;br&gt;ночной трекинг: MOTA 44.61 ± 0.11&lt;br&gt;baseline_metrics.csv, baseline_summary.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="806" y="120" width="280" height="158" as="geometry"/></mxCell><mxCell id="b2" value="БЛОК DRB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="130" height="158" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Этап 4 — Реализация DRB&lt;/b&gt;&lt;br&gt;ГОТОВО&lt;br&gt;&lt;br&gt;models/drb/lqa.py, fga.py, drb.py&lt;br&gt;models/yolo_neck/neck_drb.py&lt;br&gt;LQA — 4 обучаемых числа на уровень&lt;br&gt;блок отдаёт наружу пару (признаки, Q)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="316" width="280" height="158" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Этап 5 — Обучение DRB&lt;/b&gt;&lt;br&gt;ГОТОВО — около десяти прогонов&lt;br&gt;&lt;br&gt;пробы: w0 w2 w4 boost drb_bp drb_fix&lt;br&gt;drb_ad ft_base base12&lt;br&gt;ВАЖНО: шум между сидами на 12 эпохах&lt;br&gt;σ = 0.0144 — снял шесть прежних выводов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="498" y="316" width="280" height="158" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;Этап 6 — Финальное обучение&lt;/b&gt;&lt;br&gt;ИДЁТ ПРЯМО СЕЙЧАС&lt;br&gt;&lt;br&gt;drb_ad100 сид 42: пик 0.4422 на 45-й эпохе,&lt;br&gt;остановлен на 75-й&lt;br&gt;drb_ad100 сид 123: 19 из 80 эпох,&lt;br&gt;решающий прогон, осталось около 20 часов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="806" y="316" width="280" height="158" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;Этап 7 — Аблация&lt;/b&gt;&lt;br&gt;ЧАСТИЧНО&lt;br&gt;&lt;br&gt;есть: probe_subsets.csv, init_probe.csv&lt;br&gt;&lt;br&gt;НЕТ главного: сравнения «чистка признаков&lt;br&gt;против чистки пикселей» — а это весь 3-й пункт" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1114" y="316" width="280" height="158" as="geometry"/></mxCell><mxCell id="b3" value="ТРЕКИНГ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3e3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="130" height="158" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;Этап 8 — Базовый трекинг&lt;/b&gt;&lt;br&gt;ЧАСТИЧНО&lt;br&gt;&lt;br&gt;есть: MOTA 44.61 ± 0.11 по трём сидам&lt;br&gt;track_baseline_seed42/123/2024_night.json&lt;br&gt;&lt;br&gt;нет: выбор трекера не записан&lt;br&gt;нет: режим адаптации по яркости не прогнан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="512" width="280" height="158" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;Этап 9 — LQA-guided трекинг&lt;/b&gt;&lt;br&gt;НЕ ЗАПУСКАЛСЯ НИ РАЗУ&lt;br&gt;&lt;br&gt;при этом ВЕСЬ КОД УЖЕ НАПИСАН:&lt;br&gt;inference_with_q, q_aggregation,&lt;br&gt;lqa_guided_tracker, correlation_experiment,&lt;br&gt;run_tracking_three_modes, sweep_lqa_k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="498" y="512" width="280" height="158" as="geometry"/></mxCell><mxCell id="b4" value="ИТОГ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0eef7;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="130" height="158" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;Этап 10 — Скорость и картинки&lt;/b&gt;&lt;br&gt;ЧАСТИЧНО&lt;br&gt;&lt;br&gt;замерено, один кадр 640, fp16:&lt;br&gt;baseline  28.13 мс = 36 кадров/с&lt;br&gt;с блоком  32.83 мс = 30 кадров/с&lt;br&gt;визуализация для защиты не сделана" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="708" width="280" height="158" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;Этап 11 — Текст диссертации&lt;/b&gt;&lt;br&gt;ЧЕРНОВИКИ&lt;br&gt;&lt;br&gt;есть разделы: 2.1, 2.2, 2.3, 2.4, 2.6&lt;br&gt;&lt;br&gt;НЕТ главы 1 — обзор литературы,&lt;br&gt;25–35 страниц, самая объёмная часть&lt;br&gt;хроника экспериментов: 1005 строк" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="498" y="708" width="280" height="158" as="geometry"/></mxCell><mxCell id="e_s1_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s2_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s4_s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s5_s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s6_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s8_s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s10_s11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e910" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;ПУНКТ НОВИЗНЫ 1 — блок DRB&lt;/b&gt;&lt;br&gt;Две ветви, пространственная и частотная,&lt;br&gt;в одном блоке.&lt;br&gt;&lt;br&gt;ЧАСТОТНАЯ ВЕТВЬ МЕРТВА:&lt;br&gt;маска сходится к нейтрали 4 раза из 4.&lt;br&gt;Опирается на этапы 4, 5, 7." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="806" y="512" width="280" height="158" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;ПУНКТ НОВИЗНЫ 2 — карта качества&lt;/b&gt;&lt;br&gt;Q выходит из блока наружу и задаёт&lt;br&gt;порог трекера каждой детекции.&lt;br&gt;&lt;br&gt;НЕ ПРОВЕРЕН НИ РАЗУ.&lt;br&gt;Держится на одном этапе 9 —&lt;br&gt;и только на нём." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1114" y="512" width="280" height="158" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;ПУНКТ НОВИЗНЫ 3 — признаки важнее пикселей&lt;/b&gt;&lt;br&gt;Чистить надо промежуточные признаки внутри сети, а не входную картинку.&lt;br&gt;&lt;br&gt;Доказывается аблацией этапа 7, которая не прогнана.&lt;br&gt;Инструмент доказательства — сам блок DRB, поэтому пункт 3 держится&lt;br&gt;за пункт 1 и падает вместе с ним.&lt;br&gt;&lt;br&gt;Пункт 2 за них не держится — см. страницу 4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="806" y="708" width="588" height="158" as="geometry"/></mxCell><mxCell id="nn1" value="доказывается тут" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9673a6;strokeWidth=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nn2" value="доказывается тут" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9673a6;strokeWidth=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s9" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nn3" value="доказывается тут" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9673a6;strokeWidth=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Как устроена модель" id="page2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="&lt;b&gt;Как устроен путь от кадра до трека&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t2s" value="Сплошная линия — то, что работает сегодня. Пунктир — написано, но ни разу не запускалось." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1400" height="30" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Видео BDD100K&lt;/b&gt;&lt;br&gt;кадр 1280 x 720&lt;br&gt;val: поднабор night" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="240" height="90" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Приведение размера&lt;/b&gt;&lt;br&gt;letterbox 384 x 640&lt;br&gt;IMGSZ = 640" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="240" height="90" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;YOLO26, ствол&lt;/b&gt;&lt;br&gt;backbone: свёртки, понижение&lt;br&gt;разрешения в 8, 16, 32 раза" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Шея, три уровня&lt;/b&gt;&lt;br&gt;P3 страйд 8  — мелкие объекты&lt;br&gt;P4 страйд 16 — средние&lt;br&gt;P5 страйд 32 — крупные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="240" height="110" as="geometry"/></mxCell><mxCell id="drb" value="&lt;b&gt;БЛОК DRB — три экземпляра, по одному на уровень&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="620" height="470" as="geometry"/></mxCell><mxCell id="dq" value="&lt;b&gt;Ветвь LQA — пространственная&lt;/b&gt;&lt;br&gt;дисперсия  D = avg(x²) − avg(x)²&lt;br&gt;пик        C = max(x) − avg(x)&lt;br&gt;градиент   G = Собель&lt;br&gt;все три — ФИКСИРОВАННЫЕ операции&lt;br&gt;&lt;br&gt;сборка: conv 1x1 → сигмоида&lt;br&gt;обучаемых чисел: ВСЕГО 4&lt;br&gt;&lt;br&gt;выход: карта Q в диапазоне [0, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="175" width="270" height="175" as="geometry"/></mxCell><mxCell id="df" value="&lt;b&gt;Ветвь FGA — частотная&lt;/b&gt;&lt;br&gt;rfft2 → радиальная маска → irfft2&lt;br&gt;маска обучаемая&lt;br&gt;&lt;br&gt;РЕЗУЛЬТАТ: маска сходится&lt;br&gt;к нейтрали 4 раза из 4.&lt;br&gt;Вес ветви за 12 эпох сдвинулся&lt;br&gt;на 0.002 при десятикратном разгоне.&lt;br&gt;&lt;br&gt;выход: поправленные признаки X′" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="175" width="270" height="175" as="geometry"/></mxCell><mxCell id="dm" value="&lt;b&gt;Слияние — режим затвора&lt;/b&gt;&lt;br&gt;Y = X + G ⊙ (X′ − X)&lt;br&gt;ВАЖНО: в этом режиме вес LQA не получает градиента вовсе —&lt;br&gt;значит карта качества за всё время НИ РАЗУ не обучалась." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="375" width="560" height="90" as="geometry"/></mxCell><mxCell id="dout" value="&lt;b&gt;Блок отдаёт наружу ДВА значения&lt;/b&gt;&lt;br&gt;признаки Y — идут дальше в голову&lt;br&gt;карта Q — идёт мимо головы, прямо в трекер (задумка 2-го пункта новизны)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="485" width="560" height="80" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Голова Detect (end2end)&lt;/b&gt;&lt;br&gt;выбирает топ-K анкеров&lt;br&gt;наружу отдаёт рамки, уверенность, класс&lt;br&gt;индекс анкера перехвачен обёрткой →&lt;br&gt;страйд уровня известен точно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1040" y="120" width="300" height="110" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Детекции кадра&lt;/b&gt;&lt;br&gt;xyxy — рамка в пикселях оригинала&lt;br&gt;conf — уверенность&lt;br&gt;cls  — класс&lt;br&gt;stride — с какого уровня пирамиды" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1040" y="260" width="300" height="110" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;Свёртка Q в число на рамку&lt;/b&gt;&lt;br&gt;q_i = агрегация Q внутри рамки&lt;br&gt;три варианта: mean, min, median&lt;br&gt;&lt;br&gt;ИЗМЕРЕНО: разброс внутри уровня&lt;br&gt;mean 0.008–0.015, min 0.018–0.024&lt;br&gt;связь с уверенностью: −0.35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1040" y="400" width="300" height="130" as="geometry"/></mxCell><mxCell id="tr" value="&lt;b&gt;ТРЕКЕР ByteTrack&lt;/b&gt;&lt;br&gt;Порог track_high_thresh делит детекции&lt;br&gt;на надёжные (проход 1) и слабые (проход 2).&lt;br&gt;&lt;br&gt;───────────────────────────────&lt;br&gt;Режим 1 — Standard&lt;br&gt;  порог 0.5 для всех. РАБОТАЕТ.&lt;br&gt;  MOTA 44.61 ± 0.11 у baseline,&lt;br&gt;  44.97 у модели с блоком.&lt;br&gt;&lt;br&gt;───────────────────────────────&lt;br&gt;Режим 2 — Brightness&lt;br&gt;  порог по средней яркости видео.&lt;br&gt;  НЕ ПРОГНАН.&lt;br&gt;&lt;br&gt;───────────────────────────────&lt;br&gt;Режим 3 — LQA-guided&lt;br&gt;  свой порог каждой детекции:&lt;br&gt;  τ = 0.5 − k · (1 − q_i),  k = 0.2&lt;br&gt;  НЕ ПРОГНАН. Это и есть 2-й пункт.&lt;br&gt;&lt;br&gt;───────────────────────────────&lt;br&gt;Режим 3к — Control-Global&lt;br&gt;  контрольный: тот же сдвиг, но общий&lt;br&gt;  на всё видео. Нужен, чтобы доказать,&lt;br&gt;  что дело в индивидуальности порога,&lt;br&gt;  а не в том, что порог просто ниже." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1400" y="120" width="340" height="410" as="geometry"/></mxCell><mxCell id="p2_d1_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_d2_d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_d3_d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_d4_drb" value="X" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="d4" target="drb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_dq_dm" value="Q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dq" target="dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_df_dm" value="X′" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="df" target="dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_dm_dout" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dm" target="dout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_dout_h1" value="признаки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="dout" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_h1_h2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_h2_h3" value="рамка + страйд" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_dq_h3" value="карта Q мимо головы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.2;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" parent="1" source="dq" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_h2_tr" value="conf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="h2" target="tr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_h3_tr" value="q_i — ПОКА НЕ ИДЁТ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;dashed=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="h3" target="tr"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Что доказано" id="page3"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="&lt;b&gt;Что доказано, что опровергнуто, что не проверялось&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t3s" value="Сверху вниз — по убыванию надёжности. Все числа сверены с файлами результатов." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1400" height="30" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;САМОЕ НАДЁЖНОЕ — блок втрое слабее переобучается&lt;/b&gt;&lt;br&gt;Все три контрольных прогона проходят пик и дальше 70 эпох деградируют. Прогон с блоком — почти нет.&lt;br&gt;&lt;br&gt;потеря от пика к 75-й эпохе:   контроль −0.0111, −0.0129, −0.0141   |   с блоком −0.0059&lt;br&gt;&lt;br&gt;С 35-й эпохи и до остановки блок идёт выше всех трёх контрольных на КАЖДОЙ эпохе —&lt;br&gt;тридцать три эпохи подряд. Разрыв растёт: +0.0016 на 40-й, +0.0024 на 60-й, +0.0059 на 75-й.&lt;br&gt;&lt;br&gt;ОГОВОРКА: один прогон против трёх. Сид 123 идёт сейчас — он и решает." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="840" height="175" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;СРЕДНЕЙ НАДЁЖНОСТИ — выигрыш в трекинге&lt;/b&gt;&lt;br&gt;Ночной срез, официальный инструмент BDD100K.&lt;br&gt;&lt;br&gt;MOTA          44.61 ± 0.11  →  44.97   выше всех трёх, +3.2 сигмы&lt;br&gt;IDF1          55.34 ± 0.22  →  55.60   выше всех трёх&lt;br&gt;ложные        5996–6417     →  5535    меньше всех&lt;br&gt;перебросы     4712–4807     →  4639    меньше всех&lt;br&gt;пропуски      59 765 ± 572  →  60 087  ВНУТРИ разброса, не улучшились&lt;br&gt;&lt;br&gt;МЕХАНИЗМ ОКАЗАЛСЯ НЕ ТОТ: ждали меньше пропусков, получили меньше вранья и путаницы." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="840" height="175" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;ЦЕНА БЛОКА — измерена&lt;/b&gt;&lt;br&gt;один кадр 640 x 640, fp16, RTX 5070:&lt;br&gt;   baseline  28.13 мс = 36 кадров/с&lt;br&gt;   с блоком  32.83 мс = 30 кадров/с      это +17 % времени&lt;br&gt;&lt;br&gt;ВАЖНО для планов: запаса под голову P2 (она стоит 30–50 %) НЕТ — упадём до 20–23 кадров/с.&lt;br&gt;36 кадров/с здесь не предел железа, а накладные расходы при батче 1; лечится экспортом в TensorRT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="840" height="130" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;ОПРОВЕРГНУТО — прирост по мелким объектам ночью&lt;/b&gt;&lt;br&gt;На 12 эпохах воспроизводился устойчиво: +0.027 полноты, два сида против трёх,&lt;br&gt;диапазоны не пересекались. Выглядело как настоящий результат.&lt;br&gt;&lt;br&gt;На 100 эпохах знак сменился: −0.032, ниже всех трёх контрольных.&lt;br&gt;&lt;br&gt;ПРИЧИНА: параметр close_mosaic. На 12 эпохах мозаика работает 2 эпохи из 12,&lt;br&gt;на 100 — девяносто из ста. А мозаика сама изготавливает мелкие объекты.&lt;br&gt;ВЫВОД: короткие пробы для выводов о таком блоке непригодны в принципе." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="840" height="175" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;МЕРТВО — частотная ветвь FGA&lt;/b&gt;&lt;br&gt;Маска сходится к нейтрали ЧЕТЫРЕЖДЫ ИЗ ЧЕТЫРЁХ независимых проверок:&lt;br&gt;   по отсчётам спектра,  по радиальным кольцам,&lt;br&gt;   предсказанная по кадру,  и при десятикратном разгоне обучения.&lt;br&gt;&lt;br&gt;Вес ветви за 12 эпох сдвинулся на 0.002.&lt;br&gt;&lt;br&gt;То есть сеть сама, раз за разом, решает частотную коррекцию не применять.&lt;br&gt;Это уже не «не получилось настроить» — это довод против самой операции." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="315" width="840" height="175" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;НЕ ПРОВЕРЯЛОСЬ — карта качества LQA&lt;/b&gt;&lt;br&gt;В режиме затвора вес LQA не получает градиента вовсе. Измерено на живой модели.&lt;br&gt;Половина блока не отвергнута — она НЕ ИСПЫТАНА.&lt;br&gt;&lt;br&gt;Что известно из диагностики (один прогон, не полный опыт):&lt;br&gt;   разброс внутри уровня: mean 0.008–0.015, min 0.018–0.024   — очень мало&lt;br&gt;   связь с уверенностью детектора: −0.35                      — и знак ОТРИЦАТЕЛЬНЫЙ&lt;br&gt;&lt;br&gt;Полный опыт этапа 9.5 закроет вопрос за час и без обучения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="510" width="840" height="175" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;ОТДЕЛЬНО — методический результат, который дороже самого блока&lt;/b&gt;&lt;br&gt;Разброс между прогонами обязан быть измерен ДО сравнения вариантов.&lt;br&gt;На 12 эпохах он оказался σ = 0.0144 — больше любой разницы, которую обсуждали неделю.&lt;br&gt;Шесть выводов о настройке блока пришлось признать неустановленными.&lt;br&gt;&lt;br&gt;На 100 эпохах разброс в двадцать раз меньше: σ = 0.0007 по пикам. Длинное обучение не только точнее — оно ещё и повторяемо.&lt;br&gt;Это идёт в раздел методики диссертации и остаётся верным при любой судьбе DRB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="1720" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Развилка" id="page4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4" value="&lt;b&gt;Развилка: что делать дальше&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t4s" value="Две ветки идут ПАРАЛЛЕЛЬНО и не мешают друг другу: одна занимает видеокарту, вторая — нет." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1500" height="30" as="geometry"/></mxCell><mxCell id="f0" value="&lt;b&gt;СЕЙЧАС&lt;/b&gt;&lt;br&gt;Сид 123 обучается: 19 из 80 эпох.&lt;br&gt;Осталось около 20 часов.&lt;br&gt;Видеокарта занята: 7.9 из 12 ГБ, загрузка 36 %.&lt;br&gt;&lt;br&gt;Это решающий прогон 1-го и 3-го пунктов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="380" height="130" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;ВЕТКА А — ждать сид 123 (видеокарта)&lt;/b&gt;&lt;br&gt;Пороги записаны ЗАРАНЕЕ, до прогона:&lt;br&gt;&lt;br&gt;   ночная точность mAP50  &amp;gt; 0.3803&lt;br&gt;   трекинг MOTA           &amp;gt; 44.72&lt;br&gt;   спад от пика к 75-й    &amp;lt; 0.008&lt;br&gt;&lt;br&gt;Два из трёх и больше — результат есть.&lt;br&gt;Один или ноль — направление закрывается." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="380" height="200" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;ВЕТКА Б — опыт с картой качества&lt;/b&gt;&lt;br&gt;Обучения НЕ ТРЕБУЕТ. Детектор зафиксирован.&lt;br&gt;Может идти на процессоре — видеокарту не тронет.&lt;br&gt;&lt;br&gt;Что делает: собирает пары (уверенность, q)&lt;br&gt;по ночным видео и считает корреляцию.&lt;br&gt;&lt;br&gt;Цикл проверки: ЧАС вместо СУТОК.&lt;br&gt;Нужна правка: протащить --device в два вызова." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="420" height="200" as="geometry"/></mxCell><mxCell id="f2a" value="&lt;b&gt;если |r| = 0.3–0.6 и знак ПЛЮС&lt;/b&gt;&lt;br&gt;Формула из плана рабочая.&lt;br&gt;Идём в этап 9 целиком: три режима + контроль." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="530" width="420" height="105" as="geometry"/></mxCell><mxCell id="f2b" value="&lt;b&gt;если знак МИНУС (как в диагностике)&lt;/b&gt;&lt;br&gt;Q меряет не качество, а насыщенность текстурой.&lt;br&gt;Менять знак k либо пересобирать Q. Не тупик." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="655" width="420" height="105" as="geometry"/></mxCell><mxCell id="f2c" value="&lt;b&gt;если разброс меньше 0.02&lt;/b&gt;&lt;br&gt;Порог гуляет на 0.002 — адаптации нет вовсе.&lt;br&gt;Лечится: нормировать q внутри уровня, поднять k." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="780" width="420" height="105" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;ВАРИАНТ 1 — выбросить FGA, оставить LQA&lt;/b&gt;&lt;br&gt;Что умерло — частотная ветвь. Её и убираем.&lt;br&gt;&lt;br&gt;Пункт 1: сжимается, переписывать формулировку&lt;br&gt;Пункт 2: ЦЕЛ полностью&lt;br&gt;Пункт 3: ЦЕЛ — LQA всё так же в шее&lt;br&gt;&lt;br&gt;Плюс: блок дешевеет, скорость возвращается к 36 к/с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="290" width="400" height="180" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;ВАРИАНТ 2 — заменить DRB целиком&lt;/b&gt;&lt;br&gt;LQA цепляется к ЛЮБОЙ карте признаков:&lt;br&gt;в forward параметр in_channels не используется&lt;br&gt;вовсе — проверено по коду lqa.py.&lt;br&gt;&lt;br&gt;Пункт 1: падает&lt;br&gt;Пункт 3: падает вместе с ним (инструмент — DRB)&lt;br&gt;Пункт 2: ЦЕЛ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="400" height="180" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;ВАРИАНТ 3 — Q как чистое измерение&lt;/b&gt;&lt;br&gt;Не обучать те 4 числа вовсе: усреднить три карты&lt;br&gt;поровну. Тогда Q — фиксированная мера, как Собель.&lt;br&gt;&lt;br&gt;Плюс: НЕ МОЖЕТ схлопнуться в нейтраль,&lt;br&gt;как это сделала частотная маска.&lt;br&gt;Минус: новизна пункта 2 слабеет — надо обосновывать&lt;br&gt;через применение к трекеру, а не через обучаемость." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="710" width="400" height="175" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;ЧТО ДЕЛАТЬ В ЛЮБОМ СЛУЧАЕ&lt;/b&gt;&lt;br&gt;Эти работы не зависят от судьбы блока:&lt;br&gt;&lt;br&gt;1. Глава 1, обзор литературы — 25–35 страниц,&lt;br&gt;   не начата, самая объёмная часть.&lt;br&gt;&lt;br&gt;2. Раздел методики: замер шума между сидами&lt;br&gt;   и ловушка коротких проб. Результат ценный&lt;br&gt;   сам по себе.&lt;br&gt;&lt;br&gt;3. Регистрация программы в Роспатенте&lt;br&gt;   и акт внедрения — без них практическая&lt;br&gt;   значимость уязвима на защите.&lt;br&gt;&lt;br&gt;4. Аблация этапа 7 «признаки против пикселей» —&lt;br&gt;   это весь 3-й пункт новизны, и она не прогнана." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1460" y="290" width="320" height="300" as="geometry"/></mxCell><mxCell id="f7" value="&lt;b&gt;ГЛАВНЫЙ ВЫВОД СХЕМЫ&lt;/b&gt;&lt;br&gt;Из трёх пунктов новизны:&lt;br&gt;&lt;br&gt;пункт 1 — ранен (частотная ветвь мертва)&lt;br&gt;пункт 3 — держится за пункт 1&lt;br&gt;пункт 2 — ЦЕЛ и НЕ ПРОВЕРЕН&lt;br&gt;&lt;br&gt;При этом весь код для пункта 2 написан,&lt;br&gt;обучения он не требует, а проверка стоит час.&lt;br&gt;&lt;br&gt;Самое дешёвое и самое неиспользованное&lt;br&gt;место в проекте — именно там." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1460" y="620" width="320" height="265" as="geometry"/></mxCell><mxCell id="f_0_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f0" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_0_2" value="параллельно, мешать не будет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="f0" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_2_a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2" target="f2a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_2_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="f2" target="f2b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_2_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="f2" target="f2c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_1_3" value="если пороги взяты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f1" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_1_4" value="если провалены" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="f1" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_2a_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="f2a" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_2b_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="f2b" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
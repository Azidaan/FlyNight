<mxfile host="app.diagrams.net" type="device" agent="claude-code"><diagram name="1. Блок DRB изнутри" id="p1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Блок DRB изнутри — что реально считается" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="ts" value="Формулы — из models/drb/. Жёлтым отмечено то, что ЗАМЕРЕНО в обученной модели runs/drb_ad100/seed42." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1440" height="24" as="geometry"/></mxCell><mxCell id="inp" value="&lt;b&gt;ВХОД&lt;/b&gt;&lt;br&gt;&lt;br&gt;карты признаков&lt;br&gt;из шеи YOLO&lt;br&gt;&lt;br&gt;(B, C, H, W)&lt;br&gt;C = 128 / 256 / 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="130" height="130" as="geometry"/></mxCell><mxCell id="drb" value="&lt;b&gt;DRB — Degradation-Resistant Block   (первый пункт новизны)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=16;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="210" y="95" width="1180" height="560" as="geometry"/></mxCell><mxCell id="lqa" value="&lt;b&gt;Пространственная ветвь LQA — «где на карте признаков плохо?»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="drb"><mxGeometry x="30" y="45" width="690" height="240" as="geometry"/></mxCell><mxCell id="o_d" value="&lt;b&gt;Дисперсия  D&lt;/b&gt;&lt;br&gt;avg(x²) − [avg(x)]²&lt;br&gt;окно 3×3, скользящее&lt;br&gt;&lt;br&gt;мало → однородно:&lt;br&gt;засветка, темнота" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="20" y="40" width="200" height="105" as="geometry"/></mxCell><mxCell id="o_c" value="&lt;b&gt;Пиковая активация  C&lt;/b&gt;&lt;br&gt;max(x) − avg(x)&lt;br&gt;окно 3×3, скользящее&lt;br&gt;&lt;br&gt;мало → нет ярких&lt;br&gt;откликов фильтров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="240" y="40" width="200" height="105" as="geometry"/></mxCell><mxCell id="o_g" value="&lt;b&gt;Градиент Собеля  G&lt;/b&gt;&lt;br&gt;√( (Kx⊛x)² + (Ky⊛x)² )&lt;br&gt;ядра ФИКСИРОВАНЫ&lt;br&gt;&lt;br&gt;мало → границы&lt;br&gt;размыты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="460" y="40" width="205" height="105" as="geometry"/></mxCell><mxCell id="o_avg" value="все три усредняются ПО КАНАЛАМ:  (B, C, H, W) → (B, 1, H, W)   ·   затем склейка в 3 канала" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#d99694;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="20" y="160" width="645" height="30" as="geometry"/></mxCell><mxCell id="o_cv" value="&lt;b&gt;Conv 1×1  →  сигмоида   ⇒   карта качества Q ∈ [0, 1]&lt;/b&gt;&lt;br&gt;единственное обучаемое место всей ветви: 3 веса + 1 смещение = 4 числа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="20" y="198" width="645" height="32" as="geometry"/></mxCell><mxCell id="fga" value="&lt;b&gt;Частотная ветвь FGA — «эквалайзер для карты признаков»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="drb"><mxGeometry x="30" y="300" width="690" height="175" as="geometry"/></mxCell><mxCell id="f_1" value="&lt;b&gt;Прямое преобразование&lt;/b&gt;&lt;br&gt;torch.fft.rfft2(x)&lt;br&gt;&lt;br&gt;карта признаков&lt;br&gt;→ спектр частот" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="20" y="40" width="195" height="95" as="geometry"/></mxCell><mxCell id="f_2" value="&lt;b&gt;Радиальная маска  M&lt;/b&gt;&lt;br&gt;обучаемая, по кольцам&lt;br&gt;от центра спектра&lt;br&gt;&lt;br&gt;центр — низкие частоты&lt;br&gt;край — высокие" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="235" y="40" width="195" height="95" as="geometry"/></mxCell><mxCell id="f_3" value="&lt;b&gt;Обратное преобразование&lt;/b&gt;&lt;br&gt;torch.fft.irfft2(спектр × M)&lt;br&gt;&lt;br&gt;обратно в карту&lt;br&gt;признаков  X′" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="450" y="40" width="215" height="95" as="geometry"/></mxCell><mxCell id="f_n" value="при нейтральной маске (M ≡ 1) выход X′ в точности равен входу X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#d99694;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="20" y="143" width="645" height="24" as="geometry"/></mxCell><mxCell id="mrg" value="&lt;b&gt;Слияние ветвей — ДВА режима&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="drb"><mxGeometry x="745" y="45" width="405" height="430" as="geometry"/></mxCell><mxCell id="m_a" value="&lt;b&gt;Режим «add» — складывающий&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y = X + σ(w_lqa)·(Q⊙X) + σ(w_fga)·FGA(X)&lt;br&gt;&lt;br&gt;веса — ВЕКТОРЫ по каналам, не числа&lt;br&gt;&lt;br&gt;беда: при старте σ(0) = 0.5 признаки&lt;br&gt;раздуваются в 1.5 раза (замер 20.08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="mrg"><mxGeometry x="20" y="40" width="365" height="145" as="geometry"/></mxCell><mxCell id="m_g" value="&lt;b&gt;Режим «gated» — затвор   ← СЕЙЧАС ЭТОТ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y = X + σ(w_fga)·Q·( FGA(X) − X )&lt;br&gt;&lt;br&gt;вносится ПОПРАВКА, а не копия ветви.&lt;br&gt;При нейтральной маске поправка — точный&lt;br&gt;ноль при любом вкладе: раздуть нельзя.&lt;br&gt;&lt;br&gt;Q работает затвором: где качество выше,&lt;br&gt;там поправка сильнее." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="mrg"><mxGeometry x="20" y="200" width="365" height="150" as="geometry"/></mxCell><mxCell id="m_o" value="&lt;b&gt;Блок отдаёт ДВА значения&lt;/b&gt;&lt;br&gt;Y — дальше в голову детектора&lt;br&gt;Q — НАРУЖУ, мимо головы, в трекер (второй пункт новизны)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="mrg"><mxGeometry x="20" y="365" width="365" height="48" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;ЗАМЕРЕНО: свёртка LQA обучилась&lt;/b&gt;&lt;br&gt;веса по трём картам  [D, C, G]:&lt;br&gt;   слой 16:  +0.32   +0.60   +1.74&lt;br&gt;   слой 19:  +0.47   +1.03   +2.48&lt;br&gt;   слой 22:  −0.35   +0.24   +1.85&lt;br&gt;смещение везде положительное: +0.58 / +0.31 / +0.45&lt;br&gt;ГРАДИЕНТ СОБЕЛЯ ПЕРЕВЕШИВАЕТ ВСЁ ОСТАЛЬНОЕ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#fff2cc"><mxGeometry x="210" y="675" width="385" height="118" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;ЗАМЕРЕНО: Q не может опуститься к нулю&lt;/b&gt;&lt;br&gt;D ≥ 0, C ≥ 0, G ≥ 0 — все три неотрицательны по построению.&lt;br&gt;Веса и смещение положительные ⇒ аргумент сигмоиды&lt;br&gt;ВСЕГДА положителен ⇒ Q прижата к единице.&lt;br&gt;&lt;br&gt;фактический разброс: 0.918 … 0.999&lt;br&gt;это 8% от шкалы [0,1], под которую писалась формула порога" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#fff2cc"><mxGeometry x="615" y="675" width="385" height="118" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;ЗАМЕРЕНО: w_lqa — ровно нули&lt;/b&gt;&lt;br&gt;все 896 каналов на трёх уровнях: 0.00000&lt;br&gt;&lt;br&gt;В режиме затвора w_lqa в формуле НЕ УЧАСТВУЕТ —&lt;br&gt;см. drb.py:74. Параметр не «плохо учился»,&lt;br&gt;он не был подключён.&lt;br&gt;w_fga при этом сдвинулся: до 1.19 на слое 16." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#fff2cc"><mxGeometry x="1020" y="675" width="370" height="118" as="geometry"/></mxCell><mxCell id="e_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inp" target="drb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_lq" value="Q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="o_cv" target="m_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_fg" value="X′" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="f_3" target="m_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="o_d" target="o_avg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o_c" target="o_avg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="o_g" target="o_avg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o_avg" target="o_cv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f_1" target="f_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f_2" target="f_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_mg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m_g" target="m_o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="outp" value="&lt;b&gt;ВЫХОД&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y — в голову&lt;br&gt;детектора&lt;br&gt;&lt;br&gt;Q — в трекер&lt;br&gt;(пока не идёт)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1430" y="300" width="130" height="130" as="geometry"/></mxCell><mxCell id="e_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="drb" target="outp"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Где блок стоит в сети" id="p2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="730" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Где блок стоит в YOLO26 и что через него течёт" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="t2s" value="Три независимых экземпляра блока, у каждого свои веса, своя маска и своя свёртка." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1440" height="24" as="geometry"/></mxCell><mxCell id="im" value="&lt;b&gt;Кадр&lt;/b&gt;&lt;br&gt;&lt;br&gt;1280 × 720&lt;br&gt;↓ letterbox&lt;br&gt;384 × 640" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="150" height="120" as="geometry"/></mxCell><mxCell id="bb" value="&lt;b&gt;Ствол (backbone)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="240" height="560" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;свёртки, понижение&lt;/b&gt;&lt;br&gt;&lt;br&gt;разрешение падает&lt;br&gt;в 2, 4, 8, 16, 32 раза&lt;br&gt;&lt;br&gt;наружу отдаются&lt;br&gt;три уровня" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="25" y="45" width="190" height="150" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;P3  страйд 8&lt;/b&gt;&lt;br&gt;128 каналов&lt;br&gt;48 × 80 клеток" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="25" y="215" width="190" height="110" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;P4  страйд 16&lt;/b&gt;&lt;br&gt;256 каналов&lt;br&gt;24 × 40 клеток" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="25" y="340" width="190" height="110" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;P5  страйд 32&lt;/b&gt;&lt;br&gt;512 каналов&lt;br&gt;12 × 20 клеток" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="25" y="465" width="190" height="80" as="geometry"/></mxCell><mxCell id="nk" value="&lt;b&gt;Шея (neck) — тут и врезан блок&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="470" height="560" as="geometry"/></mxCell><mxCell id="nk16" value="&lt;b&gt;слой 16   —   DRB #1&lt;/b&gt;&lt;br&gt;&lt;br&gt;каналов: 128      страйд: 8      мелкие объекты&lt;br&gt;&lt;br&gt;внутри: своя свёртка LQA (4 числа),&lt;br&gt;своя радиальная маска FGA,&lt;br&gt;свой вектор весов w_lqa (128) и w_fga (128)&lt;br&gt;&lt;br&gt;отдаёт: признаки Y  и  карту Q размера (1, H, W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="nk"><mxGeometry x="25" y="45" width="420" height="150" as="geometry"/></mxCell><mxCell id="nk19" value="&lt;b&gt;слой 19   —   DRB #2&lt;/b&gt;&lt;br&gt;&lt;br&gt;каналов: 256      страйд: 16      средние объекты&lt;br&gt;&lt;br&gt;внутри: своя свёртка LQA (4 числа),&lt;br&gt;своя радиальная маска FGA,&lt;br&gt;свой вектор весов w_lqa (256) и w_fga (256)&lt;br&gt;&lt;br&gt;отдаёт: признаки Y  и  карту Q размера (1, H, W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="nk"><mxGeometry x="25" y="220" width="420" height="150" as="geometry"/></mxCell><mxCell id="nk22" value="&lt;b&gt;слой 22   —   DRB #3&lt;/b&gt;&lt;br&gt;&lt;br&gt;каналов: 512      страйд: 32      крупные объекты&lt;br&gt;&lt;br&gt;внутри: своя свёртка LQA (4 числа),&lt;br&gt;своя радиальная маска FGA,&lt;br&gt;свой вектор весов w_lqa (512) и w_fga (512)&lt;br&gt;&lt;br&gt;отдаёт: признаки Y  и  карту Q размера (1, H, W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="nk"><mxGeometry x="25" y="395" width="420" height="150" as="geometry"/></mxCell><mxCell id="hd" value="&lt;b&gt;Голова Detect (end2end)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="300" height="560" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;выбор анкеров&lt;/b&gt;&lt;br&gt;&lt;br&gt;get_topk_index&lt;br&gt;берёт лучшие K анкеров&lt;br&gt;&lt;br&gt;индексы перехвачены&lt;br&gt;обёрткой →&lt;br&gt;страйд каждой детекции&lt;br&gt;известен ТОЧНО" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="hd"><mxGeometry x="25" y="45" width="250" height="130" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;детекции кадра&lt;/b&gt;&lt;br&gt;&lt;br&gt;xyxy — рамка в пикселях&lt;br&gt;conf — уверенность&lt;br&gt;cls  — класс&lt;br&gt;stride — уровень" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="hd"><mxGeometry x="25" y="195" width="250" height="120" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;без блока&lt;/b&gt;&lt;br&gt;&lt;br&gt;baseline: 28.13 мс&lt;br&gt;= 36 кадров/с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="hd"><mxGeometry x="25" y="335" width="250" height="90" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;с блоком&lt;/b&gt;&lt;br&gt;&lt;br&gt;DRB: 32.83 мс&lt;br&gt;= 30 кадров/с    (+17 %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="hd"><mxGeometry x="25" y="440" width="250" height="90" as="geometry"/></mxCell><mxCell id="q_im" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="im" target="bb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="nk16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="nk19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="nk22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_n1" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="nk16" target="hd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_n2" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="nk19" target="hd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_n3" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.55;" edge="1" parent="1" source="nk22" target="hd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nq" value="&lt;b&gt;Куда девается карта Q&lt;/b&gt;&lt;br&gt;Ultralytics наружу её не отдаёт: predict() возвращает&lt;br&gt;только детекции.&lt;br&gt;&lt;br&gt;Обход уже написан (tracking/inference_with_q.py):&lt;br&gt;обёртка DRBWrappedLayer запоминает last_q при каждом&lt;br&gt;проходе, потом карты собираются через collect_q_maps&lt;br&gt;и сопоставляются уровням по head.f и head.stride.&lt;br&gt;&lt;br&gt;Это подэтап 9.1 плана. Код есть, ни разу не запускался&lt;br&gt;до 25.08.2026." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#e1d5e7"><mxGeometry x="1390" y="200" width="330" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Путь карты качества" id="p3"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="Путь карты качества наружу: от Q до порога трекера" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t3s" value="Это второй пункт новизны целиком. Числа справа — замер 25.08 на 8560 детекциях ночного поднабора." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1440" height="24" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1 · Карта Q с уровня&lt;/b&gt;&lt;br&gt;&lt;br&gt;форма (B, 1, H, W)&lt;br&gt;разрешение — как у уровня:&lt;br&gt;48×80, 24×40 или 12×20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="120" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 · Рамка детекции&lt;/b&gt;&lt;br&gt;&lt;br&gt;xyxy в пикселях ОРИГИНАЛА&lt;br&gt;↓ пересчёт в клетки карты&lt;br&gt;делением на страйд&lt;br&gt;&lt;br&gt;страйд взят из индекса анкера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="300" height="130" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 · Свёртка Q по рамке&lt;/b&gt;&lt;br&gt;&lt;br&gt;q_i = агрегация Q внутри рамки&lt;br&gt;&lt;br&gt;три варианта:&lt;br&gt;mean (основной по плану)&lt;br&gt;min · median (для аблации)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="300" height="145" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 · Порог этой детекции&lt;/b&gt;&lt;br&gt;&lt;br&gt;τ_i = τ_base − k · (1 − q_i)&lt;br&gt;&lt;br&gt;τ_base = 0.5   (track_high_thresh)&lt;br&gt;k = 0.2  по умолчанию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="300" height="130" as="geometry"/></mxCell><mxCell id="bt" value="&lt;b&gt;ByteTrack — двухпроходное связывание&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="430" height="400" as="geometry"/></mxCell><mxCell id="t_1" value="&lt;b&gt;Проход 1 — надёжные&lt;/b&gt;&lt;br&gt;детекции с conf ≥ τ&lt;br&gt;сопоставляются с треками первыми" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bt"><mxGeometry x="25" y="45" width="380" height="90" as="geometry"/></mxCell><mxCell id="t_2" value="&lt;b&gt;Проход 2 — слабые&lt;/b&gt;&lt;br&gt;детекции с conf &amp;lt; τ&lt;br&gt;подбираются тем, что осталось без пары" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bt"><mxGeometry x="25" y="150" width="380" height="90" as="geometry"/></mxCell><mxCell id="t_3" value="&lt;b&gt;ЧТО НА САМОМ ДЕЛЕ ДЕЛАЕТ ПОРОГ&lt;/b&gt;&lt;br&gt;&lt;br&gt;ByteTrack НЕ выбрасывает детекции ниже порога.&lt;br&gt;Порог лишь перераспределяет их между проходами&lt;br&gt;и влияет на рождение новых треков.&lt;br&gt;&lt;br&gt;Формулировать в тексте надо точно — оппонент,&lt;br&gt;знающий алгоритм, поймает на неточности." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bt"><mxGeometry x="25" y="255" width="380" height="120" as="geometry"/></mxCell><mxCell id="md" value="&lt;b&gt;Четыре режима, которые надо сравнить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="400" y="545" width="430" height="190" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Режим 1 · Standard&lt;/b&gt;&lt;br&gt;порог 0.5 у всех&lt;br&gt;ПРОГНАН" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="20" y="40" width="195" height="62" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Режим 2 · Brightness&lt;/b&gt;&lt;br&gt;порог по яркости видео&lt;br&gt;не прогнан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="220" y="40" width="190" height="62" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Режим 3 · LQA-guided&lt;/b&gt;&lt;br&gt;свой порог каждому&lt;br&gt;НЕ ПРОГНАН" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="20" y="112" width="195" height="62" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Режим 3к · Control&lt;/b&gt;&lt;br&gt;общий сдвиг порога&lt;br&gt;не прогнан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="220" y="112" width="190" height="62" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;ЗАМЕР: Q прижата к единице&lt;/b&gt;&lt;br&gt;диапазон по 8560 детекциям:  0.918 … 0.999&lt;br&gt;среднее 0.9793,  разброс 0.0099&lt;br&gt;&lt;br&gt;формула писалась под q из [0, 1].&lt;br&gt;Занято 8 % шкалы, значит (1 − q) ≤ 0.08,&lt;br&gt;и поправка к порогу физически не может&lt;br&gt;превысить 0.2 × 0.08 = 0.016." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#fff2cc"><mxGeometry x="890" y="120" width="420" height="175" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;ЗАМЕР: знак связи МЕНЯЕТСЯ по уровням&lt;/b&gt;&lt;br&gt;связь q с уверенностью детектора:&lt;br&gt;&lt;br&gt;   страйд 8   (мелкие)     n=5441     +0.336&lt;br&gt;   страйд 16  (средние)    n=2723     −0.350&lt;br&gt;   страйд 32  (крупные)    n=396      −0.612&lt;br&gt;   всё вместе              n=8560     +0.277&lt;br&gt;&lt;br&gt;Общее число складывается из противоположных&lt;br&gt;слагаемых. Один коэффициент k не может быть&lt;br&gt;верен для всех трёх уровней сразу." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#f8cecc"><mxGeometry x="890" y="315" width="420" height="205" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;ЧТО ДАЁТ НОРМИРОВКА ВНУТРИ УРОВНЯ&lt;/b&gt;&lt;br&gt;если заменить q на его ранг внутри своего уровня:&lt;br&gt;&lt;br&gt;                            размах порога&lt;br&gt;   как в плане                  0.016&lt;br&gt;   с нормировкой                0.200      в 12 раз шире&lt;br&gt;&lt;br&gt;порог начинает реально гулять от 0.30 до 0.50 —&lt;br&gt;вот это уже индивидуальная адаптация.&lt;br&gt;&lt;br&gt;Проверено скриптом scripts/q_level_breakdown.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#d5e8d4"><mxGeometry x="890" y="540" width="420" height="195" as="geometry"/></mxCell><mxCell id="z_s1s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z_s2s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z_s3s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z_s4bt" value="τ_i" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="s4" target="bt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z_btmd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bt" target="md"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Почему Q вышла такой" id="p4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4" value="Почему карта качества вышла именно такой — цепочка причин" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t4s" value="Каждое звено — либо строка кода, либо замер. Читать сверху вниз." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1440" height="24" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Режим затвора выбран, чтобы не раздувать признаки&lt;/b&gt;&lt;br&gt;&lt;br&gt;Складывающая форма при старте давала 1.5× по признакам,&lt;br&gt;и точность рамок предобученной головы падала до обучения.&lt;br&gt;Затвор вносит поправку: Y = X + σ(w_fga)·Q·(FGA(X) − X)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="900" height="100" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;В формуле затвора w_lqa НЕ УЧАСТВУЕТ&lt;/b&gt;&lt;br&gt;&lt;br&gt;drb.py:74-78 — в ветку затвора входит только w_fga.&lt;br&gt;ЗАМЕР: все 896 каналов w_lqa на трёх уровнях = 0.00000.&lt;br&gt;Параметр не учился плохо — он не был подключён." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="248" width="900" height="100" as="geometry"/></mxCell><mxCell id="ch1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Но сама Q участвует — множителем к затвору&lt;/b&gt;&lt;br&gt;&lt;br&gt;gate = σ(w_fga) · Q.  Значит свёртка внутри LQA градиент ПОЛУЧАЛА&lt;br&gt;и обучилась: вес градиента Собеля везде втрое-впятеро больше прочих." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="386" width="900" height="82" as="geometry"/></mxCell><mxCell id="ch2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Градиент к Q шёл через множитель (FGA(X) − X)&lt;/b&gt;&lt;br&gt;&lt;br&gt;А частотная маска сошлась к нейтрали — 4 независимые проверки из 4.&lt;br&gt;При нейтральной маске FGA(X) ≈ X, значит эта разность ≈ 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="506" width="900" height="82" as="geometry"/></mxCell><mxCell id="ch3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ВЫВОД: Q обучалась через почти перекрытый канал — и не тому&lt;/b&gt;&lt;br&gt;&lt;br&gt;Не «где качество низкое», а «где применять частотную поправку».&lt;br&gt;Причём поправку, которой уже не было." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="626" width="900" height="82" as="geometry"/></mxCell><mxCell id="ch4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Плюс независимая беда: Q не может уйти от единицы&lt;/b&gt;&lt;br&gt;&lt;br&gt;D ≥ 0, C ≥ 0, G ≥ 0 по построению; веса и смещение положительны.&lt;br&gt;Аргумент сигмоиды всегда положителен ⇒ Q ∈ [0.918, 0.999].&lt;br&gt;Нормировки перед сигмоидой в lqa.py нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="746" width="900" height="100" as="geometry"/></mxCell><mxCell id="ch5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ИТОГ: измеренная Q — не проверка идеи, а побочный продукт мёртвой ветви&lt;/b&gt;&lt;br&gt;&lt;br&gt;Второй пункт новизны по-прежнему НЕ ИСПЫТАН.&lt;br&gt;Зато теперь известно, что мешало его испытать." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="884" width="900" height="82" as="geometry"/></mxCell><mxCell id="ch6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;ЧТО ИЗ ЭТОГО СЛЕДУЕТ ДЕЛАТЬ&lt;/b&gt;&lt;br&gt;1. Нормировать q внутри уровня.&lt;br&gt;   Проверено: размах порога растёт в 12 раз. Бесплатно,&lt;br&gt;   обучения не требует.&lt;br&gt;&lt;br&gt;2. Взять Q как ФИКСИРОВАННОЕ измерение, без обучения.&lt;br&gt;   Не может схлопнуться, потому что не обучается.&lt;br&gt;   Не зависит от судьбы блока.&lt;br&gt;   Объяснима на защите: дисперсия, контраст, градиент —&lt;br&gt;   классика оценки качества изображения.&lt;br&gt;&lt;br&gt;3. Свой коэффициент k на каждый уровень — раз знак&lt;br&gt;   связи на уровнях разный.&lt;br&gt;&lt;br&gt;4. Для режима «только LQA» нужна тождественная форма:&lt;br&gt;   Y = X + a₁·(Q⊙X − X).  Так как Q ≤ 1, это ПРИГЛУШАЕТ&lt;br&gt;   плохие места вместо раздувания всего подряд." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#d5e8d4"><mxGeometry x="1010" y="110" width="460" height="250" as="geometry"/></mxCell><mxCell id="flag" value="&lt;b&gt;ГОТОВЫЕ ФЛАГИ, КОТОРЫМИ ЭТО ЗАПУСКАЕТСЯ&lt;/b&gt;&lt;br&gt;train_drb.py --variant lqa     → только карта качества&lt;br&gt;                                  каталог ablation_lqa_only&lt;br&gt;train_drb.py --variant input   → блок на входной картинке&lt;br&gt;                                  каталог ablation_drb_input&lt;br&gt;                                  ЭТО И ЕСТЬ 3-й ПУНКТ НОВИЗНЫ&lt;br&gt;&lt;br&gt;ЛОВУШКА: в режиме lqa затвор не включается (drb.py:74&lt;br&gt;требует частотной ветви), идёт складывающая форма,&lt;br&gt;и при σ(0)=0.5 признаки раздуваются в 1.5 раза.&lt;br&gt;&lt;br&gt;Обход готовым флагом:  --alpha-init -4&lt;br&gt;даёт вклад около 2 %, то есть почти тождество на старте." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#fff2cc"><mxGeometry x="1010" y="385" width="460" height="205" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;ЦЕНА, КОТОРУЮ УЖЕ ПЛАТИМ&lt;/b&gt;&lt;br&gt;один кадр 640×640, fp16, RTX 5070:&lt;br&gt;&lt;br&gt;   без блока    28.13 мс   =   36 кадров/с&lt;br&gt;   с блоком     32.83 мс   =   30 кадров/с&lt;br&gt;&lt;br&gt;Это +17 % времени за ветвь, которая сошлась к нейтрали.&lt;br&gt;Выбросив FGA, скорость возвращается почти целиком.&lt;br&gt;&lt;br&gt;Запаса под голову P2 (стоит 30–50 %) сейчас НЕТ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;fontSize=10;arcSize=10;dashed=1;" vertex="1" parent="#f8cecc"><mxGeometry x="1010" y="615" width="460" height="155" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
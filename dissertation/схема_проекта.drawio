<mxfile host="app.diagrams.net" type="device" agent="claude-code"><diagram name="1. Блок DRB изнутри" id="p1"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Блок DRB изнутри — устройство и замеры" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="ts" value="Каждый жёлтый прямоугольник — число, снятое с обученной модели runs/drb_ad100/seed42. Белые — устройство по коду models/drb/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;◆ жёлтое — ЗАМЕРЕНО на обученной модели&lt;br&gt;   красное — замер, показавший поломку&lt;br&gt;   зелёное — замер, показавший, что работает&lt;br&gt;   белое — устройство: формулы и операции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="300" height="78" as="geometry"/></mxCell><mxCell id="inp" value="&lt;b&gt;ВХОД&lt;/b&gt;&lt;br&gt;&lt;br&gt;карты признаков из шеи&lt;br&gt;(B, C, H, W)&lt;br&gt;C = 128 / 256 / 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="145" height="120" as="geometry"/></mxCell><mxCell id="drb" value="&lt;b&gt;DRB — Degradation-Resistant Block   ·   первый пункт новизны&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=16;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="225" y="92" width="1210" height="690" as="geometry"/></mxCell><mxCell id="lqa" value="&lt;b&gt;Пространственная ветвь LQA — «где на карте признаков плохо?»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="drb"><mxGeometry x="25" y="42" width="715" height="350" as="geometry"/></mxCell><mxCell id="o_d" value="&lt;b&gt;Дисперсия  D&lt;/b&gt;&lt;br&gt;avg(x²) − [avg(x)]²&lt;br&gt;окно 3×3&lt;br&gt;мало → засветка, темнота" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="18" y="38" width="220" height="92" as="geometry"/></mxCell><mxCell id="o_c" value="&lt;b&gt;Пиковая активация  C&lt;/b&gt;&lt;br&gt;max(x) − avg(x)&lt;br&gt;окно 3×3&lt;br&gt;мало → нет ярких откликов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="250" y="38" width="220" height="92" as="geometry"/></mxCell><mxCell id="o_g" value="&lt;b&gt;Градиент Собеля  G&lt;/b&gt;&lt;br&gt;√((Kx⊛x)² + (Ky⊛x)²)&lt;br&gt;ядра ФИКСИРОВАНЫ&lt;br&gt;мало → границы размыты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="482" y="38" width="215" height="92" as="geometry"/></mxCell><mxCell id="md" value="&lt;b&gt;◆ ЗАМЕРЕНО&lt;/b&gt;&lt;br&gt;вес этой карты в свёртке:&lt;br&gt;слой 16 · 19 · 22&lt;br&gt;+0.32   +0.47   −0.35&lt;br&gt;самый слабый вклад" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="lqa"><mxGeometry x="18" y="138" width="220" height="74" as="geometry"/></mxCell><mxCell id="mc" value="&lt;b&gt;◆ ЗАМЕРЕНО&lt;/b&gt;&lt;br&gt;вес этой карты в свёртке:&lt;br&gt;слой 16 · 19 · 22&lt;br&gt;+0.60   +1.03   +0.24&lt;br&gt;средний вклад" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="lqa"><mxGeometry x="250" y="138" width="220" height="74" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b&gt;◆ ЗАМЕРЕНО&lt;/b&gt;&lt;br&gt;вес этой карты в свёртке:&lt;br&gt;слой 16 · 19 · 22&lt;br&gt;+1.74   +2.48   +1.85&lt;br&gt;ПЕРЕВЕШИВАЕТ ОБЕ ДРУГИЕ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="lqa"><mxGeometry x="482" y="138" width="215" height="74" as="geometry"/></mxCell><mxCell id="o_avg" value="усреднение ПО КАНАЛАМ: (B,C,H,W) → (B,1,H,W)   ·   склейка трёх карт в 3 канала" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#d99694;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="18" y="222" width="679" height="26" as="geometry"/></mxCell><mxCell id="o_cv" value="&lt;b&gt;Conv 1×1 → сигмоида   ⇒   карта качества Q ∈ [0,1]&lt;/b&gt;&lt;br&gt;единственное обучаемое место ветви: 3 веса + 1 смещение = 4 числа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="lqa"><mxGeometry x="18" y="256" width="679" height="30" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;◆ ЗАМЕРЕНО: Q физически не может уйти от единицы&lt;/b&gt;&lt;br&gt;D ≥ 0, C ≥ 0, G ≥ 0 по построению · веса и смещение (+0.58/+0.31/+0.45) положительны ⇒ аргумент сигмоиды всегда &amp;gt; 0&lt;br&gt;фактический разброс по 129 836 детекциям ночного поднабора:  0.9183 … 0.9987  ·  среднее 0.9766  ·  это 8.0 % шкалы [0,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;" vertex="1" parent="lqa"><mxGeometry x="18" y="294" width="679" height="48" as="geometry"/></mxCell><mxCell id="fga" value="&lt;b&gt;Частотная ветвь FGA — «эквалайзер для карты признаков»&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="drb"><mxGeometry x="25" y="408" width="715" height="250" as="geometry"/></mxCell><mxCell id="f_1" value="&lt;b&gt;Прямое преобразование&lt;/b&gt;&lt;br&gt;torch.fft.rfft2(x)&lt;br&gt;&lt;br&gt;признаки → спектр" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="18" y="38" width="215" height="88" as="geometry"/></mxCell><mxCell id="f_2" value="&lt;b&gt;Радиальная маска  M&lt;/b&gt;&lt;br&gt;обучаемая, по кольцам&lt;br&gt;центр — низкие частоты&lt;br&gt;край — высокие" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="245" y="38" width="215" height="88" as="geometry"/></mxCell><mxCell id="f_3" value="&lt;b&gt;Обратное преобразование&lt;/b&gt;&lt;br&gt;torch.fft.irfft2(спектр × M)&lt;br&gt;&lt;br&gt;обратно в признаки X′" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="fga"><mxGeometry x="472" y="38" width="225" height="88" as="geometry"/></mxCell><mxCell id="mf" value="&lt;b&gt;◆ ЗАМЕРЕНО: маска сошлась к нейтрали ЧЕТЫРЕЖДЫ ИЗ ЧЕТЫРЁХ&lt;/b&gt;&lt;br&gt;проверено независимо: по отсчётам спектра · по радиальным кольцам · предсказанная по кадру · при десятикратном разгоне обучения&lt;br&gt;вес ветви за 12 эпох сдвинулся на 0.002&lt;br&gt;&lt;br&gt;при нейтральной маске (M ≡ 1) выход X′ в ТОЧНОСТИ равен входу X — то есть ветвь не делает ничего&lt;br&gt;сеть раз за разом сама решает частотную коррекцию не применять" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;" vertex="1" parent="fga"><mxGeometry x="18" y="134" width="679" height="100" as="geometry"/></mxCell><mxCell id="mrg" value="&lt;b&gt;Слияние ветвей — два режима&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="drb"><mxGeometry x="762" y="42" width="425" height="616" as="geometry"/></mxCell><mxCell id="m_a" value="&lt;b&gt;Режим «add» — складывающий&lt;/b&gt;&lt;br&gt;Y = X + σ(w_lqa)·(Q⊙X) + σ(w_fga)·FGA(X)&lt;br&gt;&lt;br&gt;веса — ВЕКТОРЫ по каналам, не числа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="mrg"><mxGeometry x="18" y="38" width="385" height="108" as="geometry"/></mxCell><mxCell id="mad" value="&lt;b&gt;◆ ЗАМЕРЕНО 20.08: почему от него отказались&lt;/b&gt;&lt;br&gt;на старте σ(0) = 0.5, а Q ≈ 0.98 ⇒ признаки раздуваются в 1.49 раза&lt;br&gt;точность рамок предобученной головы падала вдвое ЕЩЁ ДО обучения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;" vertex="1" parent="mrg"><mxGeometry x="18" y="154" width="385" height="68" as="geometry"/></mxCell><mxCell id="m_g" value="&lt;b&gt;Режим «gated» — затвор   ← РАБОТАЕТ СЕЙЧАС&lt;/b&gt;&lt;br&gt;Y = X + σ(w_fga)·Q·( FGA(X) − X )&lt;br&gt;&lt;br&gt;вносится поправка, а не копия ветви:&lt;br&gt;при нейтральной маске это точный ноль" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="mrg"><mxGeometry x="18" y="236" width="385" height="112" as="geometry"/></mxCell><mxCell id="mgz" value="&lt;b&gt;◆ ЗАМЕРЕНО: w_lqa — РОВНО НУЛИ&lt;/b&gt;&lt;br&gt;слой 16: 128 каналов, нулей 128&lt;br&gt;слой 19: 256 каналов, нулей 256&lt;br&gt;слой 22: 512 каналов, нулей 512&lt;br&gt;В формуле затвора w_lqa НЕ УЧАСТВУЕТ (drb.py:74).&lt;br&gt;Параметр не «плохо учился» — он не подключён." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;" vertex="1" parent="mrg"><mxGeometry x="18" y="356" width="385" height="96" as="geometry"/></mxCell><mxCell id="mgf" value="&lt;b&gt;◆ ЗАМЕРЕНО: w_fga сдвинулся, но мало&lt;/b&gt;&lt;br&gt;наибольшее по модулю значение на слой:&lt;br&gt;слой 16: 1.188   ·   слой 19: 0.148   ·   слой 22: 0.109&lt;br&gt;ровных нулей нет ни одного — этот параметр учился" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="mrg"><mxGeometry x="18" y="460" width="385" height="66" as="geometry"/></mxCell><mxCell id="m_o" value="&lt;b&gt;Блок отдаёт ДВА значения&lt;/b&gt;&lt;br&gt;Y — дальше в голову детектора&lt;br&gt;Q — НАРУЖУ, мимо головы, в трекер&lt;br&gt;(второй пункт новизны)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="mrg"><mxGeometry x="18" y="534" width="385" height="62" as="geometry"/></mxCell><mxCell id="outp" value="&lt;b&gt;ВЫХОД&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y — в голову&lt;br&gt;Q — в трекер&lt;br&gt;(пока не идёт)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1475" y="380" width="145" height="120" as="geometry"/></mxCell><mxCell id="e_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="inp" target="drb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="drb" target="outp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="o_d" target="o_avg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o_c" target="o_avg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="o_g" target="o_avg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_avg" target="o_cv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f_1" target="f_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f_2" target="f_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_lq" value="Q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_cv" target="m_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_fg" value="X′" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="f_3" target="m_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_mg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m_g" target="m_o"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Где блок стоит в сети" id="p2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="770" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Где блок стоит в YOLO26 и что через него течёт" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="t2s" value="Три независимых экземпляра. У каждого свои веса, своя маска, своя свёртка — и свой замер." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell><mxCell id="im" value="&lt;b&gt;Кадр&lt;/b&gt;&lt;br&gt;1280 × 720&lt;br&gt;↓ letterbox&lt;br&gt;384 × 640" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="150" height="110" as="geometry"/></mxCell><mxCell id="bb" value="&lt;b&gt;Ствол (backbone)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="230" y="92" width="215" height="620" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;свёртки, понижение&lt;/b&gt;&lt;br&gt;разрешение падает&lt;br&gt;в 2, 4, 8, 16, 32 раза" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="18" y="40" width="180" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;P3 · страйд 8&lt;/b&gt;&lt;br&gt;128 каналов&lt;br&gt;48 × 80 клеток" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="18" y="175" width="180" height="110" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;P4 · страйд 16&lt;/b&gt;&lt;br&gt;256 каналов&lt;br&gt;24 × 40 клеток" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="18" y="325" width="180" height="110" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;P5 · страйд 32&lt;/b&gt;&lt;br&gt;512 каналов&lt;br&gt;12 × 20 клеток" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bb"><mxGeometry x="18" y="475" width="180" height="110" as="geometry"/></mxCell><mxCell id="nk" value="&lt;b&gt;Шея (neck) — сюда врезан блок&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeef0;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="490" y="92" width="520" height="620" as="geometry"/></mxCell><mxCell id="nk16" value="&lt;b&gt;слой 16   —   DRB #1   —   мелкие объекты&lt;/b&gt;&lt;br&gt;каналов 128   ·   страйд 8   ·   карта Q размера (1, H, W)&lt;br&gt;свой w_lqa (128 чисел), свой w_fga (128), своя свёртка (4 числа)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="nk"><mxGeometry x="18" y="45" width="480" height="78" as="geometry"/></mxCell><mxCell id="mk16" value="&lt;b&gt;◆ ЗАМЕРЕНО&lt;/b&gt;&lt;br&gt;w_lqa:  все 128 каналов = 0.00000   —   не подключён&lt;br&gt;w_fga:  наибольшее по модулю = 1.188&lt;br&gt;&lt;br&gt;детекций этого уровня в ночном поднаборе: 92 134&lt;br&gt;q среднее 0.9738   ·   связь с уверенностью +0.317" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="nk"><mxGeometry x="18" y="129" width="480" height="96" as="geometry"/></mxCell><mxCell id="nk19" value="&lt;b&gt;слой 19   —   DRB #2   —   средние объекты&lt;/b&gt;&lt;br&gt;каналов 256   ·   страйд 16   ·   карта Q размера (1, H, W)&lt;br&gt;свой w_lqa (256 чисел), свой w_fga (256), своя свёртка (4 числа)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="nk"><mxGeometry x="18" y="240" width="480" height="78" as="geometry"/></mxCell><mxCell id="mk19" value="&lt;b&gt;◆ ЗАМЕРЕНО&lt;/b&gt;&lt;br&gt;w_lqa:  все 256 каналов = 0.00000   —   не подключён&lt;br&gt;w_fga:  наибольшее по модулю = 0.148&lt;br&gt;&lt;br&gt;детекций этого уровня в ночном поднаборе: 29 284&lt;br&gt;q среднее 0.9870   ·   связь с уверенностью −0.259" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="nk"><mxGeometry x="18" y="324" width="480" height="96" as="geometry"/></mxCell><mxCell id="nk22" value="&lt;b&gt;слой 22   —   DRB #3   —   крупные объекты&lt;/b&gt;&lt;br&gt;каналов 512   ·   страйд 32   ·   карта Q размера (1, H, W)&lt;br&gt;свой w_lqa (512 чисел), свой w_fga (512), своя свёртка (4 числа)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="nk"><mxGeometry x="18" y="435" width="480" height="78" as="geometry"/></mxCell><mxCell id="mk22" value="&lt;b&gt;◆ ЗАМЕРЕНО&lt;/b&gt;&lt;br&gt;w_lqa:  все 512 каналов = 0.00000   —   не подключён&lt;br&gt;w_fga:  наибольшее по модулю = 0.109&lt;br&gt;&lt;br&gt;детекций этого уровня в ночном поднаборе: 8 418&lt;br&gt;q среднее 0.9720   ·   связь с уверенностью −0.286" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="nk"><mxGeometry x="18" y="519" width="480" height="96" as="geometry"/></mxCell><mxCell id="hd" value="&lt;b&gt;Голова Detect (end2end)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="1055" y="92" width="300" height="620" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;выбор анкеров&lt;/b&gt;&lt;br&gt;get_topk_index берёт лучшие K&lt;br&gt;&lt;br&gt;индексы перехвачены обёрткой ⇒&lt;br&gt;страйд детекции известен ТОЧНО&lt;br&gt;(без эвристик по размеру рамки)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="hd"><mxGeometry x="20" y="40" width="260" height="120" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;детекции кадра&lt;/b&gt;&lt;br&gt;xyxy · conf · cls · stride" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="hd"><mxGeometry x="20" y="175" width="260" height="105" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;◆ ЗАМЕРЕНО: цена по времени&lt;/b&gt;&lt;br&gt;один кадр 640×640, fp16, RTX 5070&lt;br&gt;&lt;br&gt;без блока  28.13 мс = 36 кадр/с&lt;br&gt;с блоком   32.83 мс = 30 кадр/с&lt;br&gt;&lt;br&gt;это +17 % за ветвь, которая&lt;br&gt;сошлась к нейтрали" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="hd"><mxGeometry x="20" y="295" width="260" height="120" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;◆ ЗАМЕРЕНО: что блок реально даёт&lt;/b&gt;&lt;br&gt;сопротивление переобучению —&lt;br&gt;самое надёжное из найденного:&lt;br&gt;&lt;br&gt;потеря от пика к 75-й эпохе&lt;br&gt;  контроль  −0.0111 −0.0129 −0.0141&lt;br&gt;  с блоком  −0.0059&lt;br&gt;&lt;br&gt;выше всех трёх контрольных&lt;br&gt;33 эпохи подряд без исключения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;" vertex="1" parent="hd"><mxGeometry x="20" y="430" width="260" height="165" as="geometry"/></mxCell><mxCell id="q_im" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="im" target="bb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="nk16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="nk19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="nk22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_n16" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.12;" edge="1" parent="1" source="nk16" target="hd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_n19" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.28;" edge="1" parent="1" source="nk19" target="hd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q_n22" value="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.44;" edge="1" parent="1" source="nk22" target="hd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nq" value="&lt;b&gt;◆ Как Q достаётся наружу&lt;/b&gt;&lt;br&gt;Ultralytics её не отдаёт: predict() возвращает&lt;br&gt;только детекции.&lt;br&gt;&lt;br&gt;Обход написан — tracking/inference_with_q.py:&lt;br&gt;обёртка DRBWrappedLayer запоминает last_q при&lt;br&gt;каждом проходе, затем collect_q_maps собирает&lt;br&gt;карты и сопоставляет уровням по head.f и&lt;br&gt;head.stride.&lt;br&gt;&lt;br&gt;Это подэтап 9.1 плана.&lt;br&gt;Код написан давно, ВПЕРВЫЕ запущен 25.08.2026." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="1385" y="200" width="340" height="235" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;◆ жёлтое — ЗАМЕРЕНО на обученной модели&lt;br&gt;   красное — замер, показавший поломку&lt;br&gt;   зелёное — замер, показавший, что работает&lt;br&gt;   белое — устройство: формулы и операции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1385" y="460" width="300" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Путь карты качества" id="p3"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="Путь карты качества: от Q до порога трекера" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="t3s" value="Второй пункт новизны целиком. Замеры — опыт 25.08.2026, ночной поднабор, 8560 детекций." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1 · Карта Q с уровня&lt;/b&gt;&lt;br&gt;&lt;br&gt;форма (B, 1, H, W)&lt;br&gt;разрешение как у уровня:&lt;br&gt;48×80  ·  24×40  ·  12×20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="100" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 · Рамка детекции&lt;/b&gt;&lt;br&gt;&lt;br&gt;xyxy в пикселях оригинала&lt;br&gt;↓ делением на страйд&lt;br&gt;пересчёт в клетки карты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="320" height="100" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 · Свёртка Q по рамке&lt;/b&gt;&lt;br&gt;&lt;br&gt;q_i = агрегация Q внутри рамки&lt;br&gt;mean (основной) · min · median" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="320" height="100" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 · Порог этой детекции&lt;/b&gt;&lt;br&gt;&lt;br&gt;τ_i = τ_base − k · (1 − q_i)&lt;br&gt;τ_base = 0.5   ·   k = 0.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="320" height="100" as="geometry"/></mxCell><mxCell id="zs1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="zs2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="zs3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;◆ ЗАМЕР: разброс q ничтожен&lt;/b&gt;&lt;br&gt;по всем 129 836 детекциям ночного поднабора:&lt;br&gt;   среднее 0.9766   ·   разброс 0.0091&lt;br&gt;   диапазон 0.9183 … 0.9987   —   8.0 % шкалы [0,1]&lt;br&gt;&lt;br&gt;внутри одного уровня разброс ещё меньше:&lt;br&gt;   усреднение по рамке   0.0054 … 0.0078&lt;br&gt;   минимум по рамке      0.0132 … 0.0257" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="460" height="160" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;◆ ЗАМЕР: при усреднении знак МЕНЯЕТСЯ по уровням&lt;/b&gt;&lt;br&gt;связь q с уверенностью, агрегация mean (основная по плану):&lt;br&gt;&lt;br&gt;   страйд 8   мелкие    n=92 134     +0.317&lt;br&gt;   страйд 16  средние   n=29 284     −0.259&lt;br&gt;   страйд 32  крупные   n=8 418      −0.286&lt;br&gt;   всё вместе           n=129 836    +0.309&lt;br&gt;&lt;br&gt;Общее число (0.309) формально попадает в целевую полосу&lt;br&gt;плана 0.3–0.6, но складывается из ПРОТИВОПОЛОЖНЫХ&lt;br&gt;слагаемых. Один k не годится для трёх уровней сразу." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="275" width="460" height="190" as="geometry"/></mxCell><mxCell id="xmin" value="&lt;b&gt;◆ ЗАМЕР: МИНИМУМ по рамке ведёт себя лучше среднего&lt;/b&gt;&lt;br&gt;та же связь, агрегация min:&lt;br&gt;&lt;br&gt;   страйд 8    n=92 134     −0.177&lt;br&gt;   страйд 16   n=29 284     −0.317&lt;br&gt;   страйд 32   n=8 418      −0.269&lt;br&gt;&lt;br&gt;ЗНАК ОДИН НА ВСЕХ УРОВНЯХ, и шкалы занято 21.7 %&lt;br&gt;вместо 8.0 %. Основной вариант плана (mean) — худший." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="475" width="460" height="150" as="geometry"/></mxCell><mxCell id="x3" value="&lt;b&gt;◆ ЗАМЕР: порог у всех получается одинаковый&lt;/b&gt;&lt;br&gt;что даёт формула плана на живых данных (mean):&lt;br&gt;&lt;br&gt;   среднее 0.4953   ·   разброс 0.0018&lt;br&gt;   от 0.4837 до 0.4997, весь размах 0.0161&lt;br&gt;   у min размах 0.0434 — тоже мало&lt;br&gt;&lt;br&gt;Индивидуальной адаптации НЕ ВОЗНИКАЕТ —&lt;br&gt;режим 3 совпадёт с контрольным режимом 3к." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="635" width="460" height="150" as="geometry"/></mxCell><mxCell id="x4" value="&lt;b&gt;◆ ЗАМЕР: нормировка внутри уровня чинит это&lt;/b&gt;&lt;br&gt;если заменить q рангом внутри своего уровня:&lt;br&gt;&lt;br&gt;                        размах порога&lt;br&gt;   как в плане              0.016&lt;br&gt;   с нормировкой            0.200      в 12 раз&lt;br&gt;&lt;br&gt;порог начинает гулять от 0.30 до 0.50 —&lt;br&gt;вот это уже индивидуальная адаптация.&lt;br&gt;Бесплатно: обучения не требует." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="795" width="460" height="155" as="geometry"/></mxCell><mxCell id="bt" value="&lt;b&gt;ByteTrack — двухпроходное связывание&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="420" height="330" as="geometry"/></mxCell><mxCell id="t_1" value="&lt;b&gt;Проход 1 — надёжные&lt;/b&gt;&lt;br&gt;conf ≥ τ  ·  сопоставляются первыми" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bt"><mxGeometry x="20" y="40" width="380" height="70" as="geometry"/></mxCell><mxCell id="t_2" value="&lt;b&gt;Проход 2 — слабые&lt;/b&gt;&lt;br&gt;conf &amp;lt; τ  ·  подбирают, что осталось" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="bt"><mxGeometry x="20" y="120" width="380" height="70" as="geometry"/></mxCell><mxCell id="t_3" value="&lt;b&gt;◆ ТОЧНОСТЬ ФОРМУЛИРОВКИ&lt;/b&gt;&lt;br&gt;ByteTrack НЕ выбрасывает детекции ниже порога.&lt;br&gt;Порог лишь перераспределяет их между проходами&lt;br&gt;и влияет на рождение новых треков.&lt;br&gt;&lt;br&gt;В тексте писать точно — оппонент, знающий&lt;br&gt;алгоритм, поймает на неточности." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=9;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="bt"><mxGeometry x="20" y="200" width="380" height="112" as="geometry"/></mxCell><mxCell id="md" value="&lt;b&gt;Четыре режима, которые надо сравнить&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="420" height="175" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Режим 1 · Standard&lt;/b&gt;&lt;br&gt;порог 0.5 у всех&lt;br&gt;ПРОГНАН" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="18" y="38" width="190" height="60" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Режим 2 · Brightness&lt;/b&gt;&lt;br&gt;по яркости видео&lt;br&gt;не прогнан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="212" y="38" width="190" height="60" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Режим 3 · LQA-guided&lt;/b&gt;&lt;br&gt;свой порог каждому&lt;br&gt;НЕ ПРОГНАН" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="18" y="106" width="190" height="60" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Режим 3к · Control&lt;/b&gt;&lt;br&gt;общий сдвиг порога&lt;br&gt;не прогнан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="md"><mxGeometry x="212" y="106" width="190" height="60" as="geometry"/></mxCell><mxCell id="mota" value="&lt;b&gt;◆ ЗАМЕР: что уже даёт режим 1 с блоком&lt;/b&gt;&lt;br&gt;                   контроль (3 сида)    с блоком&lt;br&gt;   MOTA            44.61 ± 0.11         44.97&lt;br&gt;   IDF1            55.34 ± 0.22         55.60&lt;br&gt;   ложные          5996 … 6417          5535&lt;br&gt;   перебросы       4712 … 4807          4639&lt;br&gt;   пропуски        59 765 ± 572         60 087&lt;br&gt;&lt;br&gt;Выигрыш НЕ в пропусках — блок меньше врёт и реже путает." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="645" width="420" height="135" as="geometry"/></mxCell><mxCell id="z_s4bt" value="τ_i" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="s4" target="bt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z_btmd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bt" target="md"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;◆ жёлтое — ЗАМЕРЕНО на обученной модели&lt;br&gt;   красное — замер, показавший поломку&lt;br&gt;   зелёное — замер, показавший, что работает&lt;br&gt;   белое — устройство: формулы и операции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Почему Q вышла такой" id="p4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4" value="Почему Q вышла такой — цепочка причин" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="t4s" value="Каждое звено — либо строка кода, либо замер. Читать сверху вниз." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Затвор выбран, чтобы не раздувать признаки&lt;/b&gt;&lt;br&gt;&lt;br&gt;Складывающая форма при старте давала 1.49× по признакам.&lt;br&gt;Затвор: Y = X + σ(w_fga)·Q·(FGA(X) − X)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="880" height="80" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;◆ ЗАМЕР: в формуле затвора w_lqa НЕ УЧАСТВУЕТ&lt;/b&gt;&lt;br&gt;&lt;br&gt;drb.py:74-78 — в ветку затвора входит только w_fga.&lt;br&gt;Все 896 каналов w_lqa на трёх уровнях = 0.00000." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="214" width="880" height="80" as="geometry"/></mxCell><mxCell id="ch1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;◆ ЗАМЕР: но сама Q участвует — множителем к затвору&lt;/b&gt;&lt;br&gt;&lt;br&gt;gate = σ(w_fga)·Q ⇒ свёртка внутри LQA градиент ПОЛУЧАЛА.&lt;br&gt;И обучилась: вес градиента Собеля везде втрое-впятеро больше прочих." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="328" width="880" height="80" as="geometry"/></mxCell><mxCell id="ch2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;◆ ЗАМЕР: градиент к Q шёл через множитель (FGA(X) − X)&lt;/b&gt;&lt;br&gt;&lt;br&gt;А маска сошлась к нейтрали — 4 независимые проверки из 4.&lt;br&gt;При нейтральной маске FGA(X) ≈ X, значит эта разность ≈ 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="442" width="880" height="80" as="geometry"/></mxCell><mxCell id="ch3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ВЫВОД: Q обучалась через почти перекрытый канал — и не тому&lt;/b&gt;&lt;br&gt;&lt;br&gt;Не «где качество низкое», а «где применять частотную поправку».&lt;br&gt;Причём поправку, которой уже не было." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="880" height="80" as="geometry"/></mxCell><mxCell id="ch4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;◆ ЗАМЕР: вдобавок Q не может уйти от единицы&lt;/b&gt;&lt;br&gt;&lt;br&gt;D ≥ 0, C ≥ 0, G ≥ 0; веса и смещение положительны ⇒ сигмоида насыщена.&lt;br&gt;Диапазон 0.918 … 0.999. Нормировки перед сигмоидой в lqa.py нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="880" height="80" as="geometry"/></mxCell><mxCell id="ch5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ИТОГ: измеренная Q — не проверка идеи, а побочный продукт мёртвой ветви&lt;/b&gt;&lt;br&gt;&lt;br&gt;Второй пункт новизны по-прежнему НЕ ИСПЫТАН.&lt;br&gt;Зато теперь известно, что мешало его испытать." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;fontSize=11;arcSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="784" width="880" height="80" as="geometry"/></mxCell><mxCell id="ch6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;ЧТО ИЗ ЭТОГО СЛЕДУЕТ ДЕЛАТЬ&lt;/b&gt;&lt;br&gt;1. Нормировать q внутри уровня.&lt;br&gt;   Проверено: размах порога растёт в 12 раз.&lt;br&gt;   Бесплатно, обучения не требует.&lt;br&gt;&lt;br&gt;2. Взять Q как ФИКСИРОВАННОЕ измерение, без обучения.&lt;br&gt;   Не может схлопнуться, потому что не обучается.&lt;br&gt;   Не зависит от судьбы блока.&lt;br&gt;   Объяснима на защите: дисперсия, контраст, градиент —&lt;br&gt;   классика оценки качества изображения.&lt;br&gt;&lt;br&gt;3. Брать МИНИМУМ по рамке, а не среднее.&lt;br&gt;   Замерено: у min знак связи один на всех уровнях,&lt;br&gt;   и шкалы занято 21.7 % вместо 8.0 %.&lt;br&gt;&lt;br&gt;4. Свой коэффициент k на каждый уровень, если&lt;br&gt;   всё же остаться на среднем — там знак разный.&lt;br&gt;&lt;br&gt;5. Для режима «только LQA» нужна тождественная форма:&lt;br&gt;   Y = X + a₁·(Q⊙X − X). Так как Q ≤ 1, это ПРИГЛУШАЕТ&lt;br&gt;   плохие места вместо раздувания всего подряд." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="100" width="470" height="320" as="geometry"/></mxCell><mxCell id="flag" value="&lt;b&gt;◆ ГОТОВЫЕ ФЛАГИ, КОТОРЫМИ ЭТО ЗАПУСКАЕТСЯ&lt;/b&gt;&lt;br&gt;train_drb.py --variant lqa    → только карта качества&lt;br&gt;                                 каталог ablation_lqa_only&lt;br&gt;train_drb.py --variant input  → блок на входной картинке&lt;br&gt;                                 каталог ablation_drb_input&lt;br&gt;                                 ЭТО И ЕСТЬ 3-й ПУНКТ НОВИЗНЫ&lt;br&gt;&lt;br&gt;ЛОВУШКА: в режиме lqa затвор не включается (drb.py:74&lt;br&gt;требует частотной ветви) — идёт складывающая форма,&lt;br&gt;и при σ(0) = 0.5 признаки раздуваются в 1.49 раза.&lt;br&gt;&lt;br&gt;Обход готовым флагом:  --alpha-init -4&lt;br&gt;даёт вклад около 2 %, почти тождество на старте." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;fontColor=#7a5c00;" vertex="1" parent="1"><mxGeometry x="990" y="440" width="470" height="215" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;◆ ЗАМЕР: цена, которую уже платим&lt;/b&gt;&lt;br&gt;один кадр 640×640, fp16, RTX 5070:&lt;br&gt;&lt;br&gt;   без блока    28.13 мс   =   36 кадров/с&lt;br&gt;   с блоком     32.83 мс   =   30 кадров/с&lt;br&gt;&lt;br&gt;Это +17 % времени за ветвь, сошедшуюся к нейтрали.&lt;br&gt;Выбросив FGA, скорость возвращается почти целиком.&lt;br&gt;&lt;br&gt;Запаса под голову P2 (стоит 30–50 %) сейчас НЕТ:&lt;br&gt;упали бы до 20–23 кадров/с, ниже реального времени." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=7;spacingTop=4;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="675" width="470" height="180" as="geometry"/></mxCell><mxCell id="lg4" value="&lt;b&gt;Как читать&lt;/b&gt;&lt;br&gt;◆ жёлтое — ЗАМЕРЕНО на обученной модели&lt;br&gt;   красное — замер, показавший поломку&lt;br&gt;   зелёное — замер, показавший, что работает&lt;br&gt;   белое — устройство: формулы и операции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="990" y="870" width="300" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5. DRB v3 — архитектура" id="page-v3-arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1370" math="0" shadow="0"><root><mxCell id="v3a_0"/><mxCell id="v3a_1" parent="0"/><mxCell id="v3a_t" value="DRB v3 — целевая архитектура: блок становится операторами шеи, карта качества получает трёх потребителей" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="v3a_1"><mxGeometry x="40" y="14" width="1740" height="30" as="geometry"/></mxCell><mxCell id="v3a_s" value="Как читать: ЗЕЛЁНОЕ — новые модули кода · СЕРОЕ — остаётся как у baseline · ОРАНЖЕВОЕ — существует только во время обучения · СИНЕЕ — потребители сигнала и метрики · КРАСНЫЙ ПУНКТИР — оговорки честности и ловушки протокола" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="v3a_1"><mxGeometry x="40" y="50" width="1740" height="36" as="geometry"/></mxCell><mxCell id="v3a_bandAug" value="Компонент 2 · Амплитудная аугментация — синтезатор погоды (только обучение)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#d79b00;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#7a4a00;" vertex="1" parent="v3a_1"><mxGeometry x="40" y="98" width="1720" height="185" as="geometry"/></mxCell><mxCell id="v3a_apair" value="Пара кадров разных условий&lt;br&gt;p = 0.5 · партнёр из другого поднабора&lt;br&gt;(день↔ночь, дождь↔ночь) с вероятностью 0.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_bandAug"><mxGeometry x="20" y="42" width="225" height="95" as="geometry"/></mxCell><mxCell id="v3a_amix" value="Амплитудный миксер (НОВЫЙ модуль)&lt;br&gt;rfft2 в fp32 → Â = β·Âi + (1−β)·Âj, фазы собственные → irfft2&lt;br&gt;β ~ U(0.3, 0.7)&lt;br&gt;амплитуда несёт условия съёмки, фаза — содержание (FDA-школа)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_bandAug"><mxGeometry x="295" y="28" width="400" height="125" as="geometry"/></mxCell><mxCell id="v3a_astd" value="Дальше обычные аугментации&lt;br&gt;(мозаика, геометрия, HSV)&lt;br&gt;— ничего не меняется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_bandAug"><mxGeometry x="750" y="48" width="230" height="88" as="geometry"/></mxCell><mxCell id="v3a_abatch" value="Батч изображений&lt;br&gt;640×640 → в сеть" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_bandAug"><mxGeometry x="1035" y="62" width="145" height="60" as="geometry"/></mxCell><mxCell id="v3a_afair" value="ЧЕСТНОСТЬ (зеркальность)&lt;br&gt;аугментация включается ОДИНАКОВЫМ флагом в ОБЕ руки — baseline и блок;&lt;br&gt;до обучения механизм проверяется гистограммами дескрипторов яркости/ВЧ-энергии: распределение должно заполнить промежуток день↔ночь, иначе обучать нельзя (этап C2 плана)&lt;br&gt;нейтрали у аугментации нет — схлопнуться не может" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;dashed=1;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_bandAug"><mxGeometry x="1215" y="28" width="480" height="128" as="geometry"/></mxCell><mxCell id="v3a_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#d79b00;fontSize=9;" edge="1" parent="v3a_bandAug" source="v3a_apair" target="v3a_amix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;fontSize=9;" edge="1" parent="v3a_bandAug" source="v3a_amix" target="v3a_astd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;fontSize=9;" edge="1" parent="v3a_bandAug" source="v3a_astd" target="v3a_abatch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_neck" value="Компонент 1 · Шея YOLO26: интерполяции слияния → частотные операторы (ЗАМЕНА операций, а не добавка к признакам)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4faf0;strokeColor=#82b366;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#2f5b23;" vertex="1" parent="v3a_1"><mxGeometry x="40" y="330" width="1440" height="520" as="geometry"/></mxCell><mxCell id="v3a_r1in" value="P5 · stride 32&lt;br&gt;слой 22&lt;br&gt;lateral вход" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="12" y="26" width="170" height="96" as="geometry"/></mxCell><mxCell id="v3a_r1op" value="слияний сверху нет —&#10;уровень проходит без изменений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;dashed=1;fontColor=#888888;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="235" y="26" width="600" height="96" as="geometry"/></mxCell><mxCell id="v3a_r1det" value="Detect · слой 22&lt;br&gt;крупные объекты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="1220" y="26" width="195" height="96" as="geometry"/></mxCell><mxCell id="v3a_r1link" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;fontSize=9;fontColor=#888888;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="v3a_neck" source="v3a_r1in" target="v3a_r1det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r2in" value="C4 · stride 16&lt;br&gt;lateral из backbone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="12" y="208" width="170" height="92" as="geometry"/></mxCell><mxCell id="v3a_r2op" value="FreqUp для уровня P4 — замена «Upsample 2× + Concat»&lt;br&gt;① апсемплинг 2× · ② depthwise conv k=3, ядро = НЧ-радиальное кольцо (форма фиксированная)&lt;br&gt;③ отсечка кольца t_c : σ(desc(c)) отображается в [f_lo, f_hi] — ОДИН скаляр на канал (НЕ отсчёт спектра),&lt;br&gt;desc = concat(mean, max) признака канала · инициализация серединой диапазона&lt;br&gt;кольцо собирает градиент со всех отсчётов сразу — перекос обучаемости низкие/высокие отсутствует" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="235" y="196" width="610" height="116" as="geometry"/></mxCell><mxCell id="v3a_r2hf" value="HF-обострение границ&lt;br&gt;y = x + g ⊙ ( H(x) − x )&lt;br&gt;H — фиксированное ВЧ-кольцо (лапласиан-класс)&lt;br&gt;g = g_max · σ(w), старт w = −4 ⇒ g ≈ 0.02 ⇒ тождество&lt;br&gt;потолок g_max мал — раздувание признаков невозможно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="885" y="196" width="295" height="116" as="geometry"/></mxCell><mxCell id="v3a_r2det" value="Detect · слой 19&lt;br&gt;средние объекты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="1220" y="208" width="195" height="92" as="geometry"/></mxCell><mxCell id="v3a_r3in" value="C3 · stride 8&lt;br&gt;lateral из backbone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="12" y="374" width="170" height="92" as="geometry"/></mxCell><mxCell id="v3a_r3op" value="FreqUp для уровня P3 — тот же оператор (шаги ①②③ выше)&lt;br&gt;здесь живёт граница мелкого объекта при входе 640:&lt;br&gt;обострение именно этого уровня бьёт в целевую клетку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="235" y="360" width="610" height="120" as="geometry"/></mxCell><mxCell id="v3a_r3hf" value="HF-обострение&lt;br&gt;y = x + g ⊙ ( H(x) − x )&lt;br&gt;тот же модуль" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="885" y="374" width="295" height="92" as="geometry"/></mxCell><mxCell id="v3a_r3det" value="★ Detect · слой 16&lt;br&gt;МЕЛКИЕ объекты&lt;br&gt;мишень PRIMARY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_neck"><mxGeometry x="1220" y="374" width="195" height="92" as="geometry"/></mxCell><mxCell id="v3a_r12up" value="поток верхнего уровня вниз → апсемплинг через FreqUp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;dashed=1;fontSize=9;fontColor=#2f5b23;labelBackgroundColor=none;" edge="1" parent="v3a_neck" source="v3a_r1op" target="v3a_r2op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r23up" value="то же для следующего уровня" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;dashed=1;fontSize=9;fontColor=#2f5b23;labelBackgroundColor=none;" edge="1" parent="v3a_neck" source="v3a_r2op" target="v3a_r3op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r2chain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;" edge="1" parent="v3a_neck" source="v3a_r2in" target="v3a_r2op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r2ch2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;" edge="1" parent="v3a_neck" source="v3a_r2op" target="v3a_r2hf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r2ch3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;" edge="1" parent="v3a_neck" source="v3a_r2hf" target="v3a_r2det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r3chain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;" edge="1" parent="v3a_neck" source="v3a_r3in" target="v3a_r3op"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r3ch2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;" edge="1" parent="v3a_neck" source="v3a_r3op" target="v3a_r3hf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_r3ch3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;" edge="1" parent="v3a_neck" source="v3a_r3hf" target="v3a_r3det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_qlink" value="Q наружу каждого уровня: ДЕТЕРМИНИРОВАННОЕ измерение (равное усреднение дисперсии / пиковой активации / градиента Собеля — четыре обучаемых веса сняты, измерению нечем схлопываться). Механизм возврата кортежем уже существует — models/drb/drb.py. Потребители — ниже." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#2f5b23;" vertex="1" parent="v3a_neck"><mxGeometry x="235" y="487" width="1180" height="26" as="geometry"/></mxCell><mxCell id="v3a_inflow" value="Backbone YOLO26n БЕЗ изменений → карты C3/C4/C5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;fontSize=9;fontColor=#666666;labelBackgroundColor=none;" edge="1" parent="v3a_1" source="v3a_abatch" target="v3a_neck"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_qband" value="Компонент 4 · Карта качества наружу — три потребителя при ЗАФИКСИРОВАННОМ детекторе (нет шума обучения → проверка за часы, не за сутки)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#2c4f75;" vertex="1" parent="v3a_1"><mxGeometry x="40" y="878" width="1010" height="300" as="geometry"/></mxCell><mxCell id="v3a_qsrc" value="Источники сигнала&lt;br&gt;q_min по рамке — агрегация МИНИМУМОМ (знак связи единый на всех уровнях пирамиды)&lt;br&gt;нормировка РАНГОМ внутри уровня — размах сигнала ×12&lt;br&gt;дескриптор зашумлённости кадра (яркость, ВЧ-энергия)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_qband"><mxGeometry x="18" y="52" width="190" height="220" as="geometry"/></mxCell><mxCell id="v3a_c1" value="① Пересчёт балла детекции (score fusion)&lt;br&gt;s′ = σ( a·logit(s) + b·z(q_rank) )&lt;br&gt;a, b — логистическая регрессия против TP/FP ТОЛЬКО на val-split&lt;br&gt;mAP — метрика ранжирования: сигнал локальности поднимает её без переобучения сети&lt;br&gt;часы работы, GPU не нужен · мишень — ночная точность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_qband"><mxGeometry x="250" y="34" width="360" height="122" as="geometry"/></mxCell><mxCell id="v3a_c2" value="② Шум наблюдения Калмана&lt;br&gt;R ∝ max(1 − ŝ, 0.05), ŝ = mix(conf, rank q_min)&lt;br&gt;обёртка tracking/lqa_guided_tracker.py уже прокидывает kwargs&lt;br&gt;режимы off / conf-only / conf+q — готовая абляция&lt;br&gt;UA-Track: малый размер объекта — главная неопределённость" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_qband"><mxGeometry x="250" y="168" width="360" height="108" as="geometry"/></mxCell><mxCell id="v3a_c3" value="③ Кондиционер тестовой адаптации (опционально, последним)&lt;br&gt;BN-статистики адаптируются на условиях цели по схеме TTN&lt;br&gt;(разделение статистик источника и цели — защита от схлопывания)&lt;br&gt;сила адаптации ∝ доле низкодостоверных областей по q&lt;br&gt;оговорка честности: контрольная рука получает ту же адаптацию,&lt;br&gt;но БЕЗ кондиционера — различие рук в использовании сигнала" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="v3a_qband"><mxGeometry x="650" y="34" width="340" height="242" as="geometry"/></mxCell><mxCell id="v3a_qe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=9;" edge="1" parent="v3a_qband" source="v3a_qsrc" target="v3a_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_qe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=9;" edge="1" parent="v3a_qband" source="v3a_qsrc" target="v3a_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_qe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6c8ebf;dashed=1;fontSize=9;" edge="1" parent="v3a_qband" source="v3a_qsrc" target="v3a_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_neckq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6c8ebf;dashed=1;fontSize=9;fontColor=#2c4f75;labelBackgroundColor=none;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="v3a_1" source="v3a_neck" target="v3a_qsrc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_crit" value="Протокол решения · пороги записаны ДО прогона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=3;align=center;verticalAlign=top;spacingTop=4;fontSize=13;fontStyle=1;arcSize=6;container=1;collapsible=0;fontColor=#2c4f75;" vertex="1" parent="v3a_1"><mxGeometry x="1070" y="878" width="690" height="300" as="geometry"/></mxCell><mxCell id="v3a_criText" value="PRIMARY · строгое AP_small ночь: во всех трёх парах сидов выше контроля и Δ средних ≥ +0.0015 (СКО контроля ±0.0005 — метрика сверхстабильна)&lt;br&gt;IDF1 ночь, классоусреднённый (mMOTA/mIDF1 как в официальной таблице eval.ai): ≥ контроль + 0.4 п.п.&lt;br&gt;Индекс деградации ΔAP(ночь−обычные | размер объекта): меньше контроля на ≥10% относительно&lt;br&gt;Чекпойнт-правило: победитель определяется по last.pt; best.pt показывается рядом&lt;br&gt;&lt;br&gt;УСПЕХ направления = выполнен PRIMARY, либо IDF1 и индекс деградации одновременно&lt;br&gt;ПРОВАЛ = первичный ниже контроля хотя бы в одной паре и оба вторичных не выполнены → v3 закрывается, отрицательный результат идёт в текст с таблицами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3a_crit"><mxGeometry x="15" y="34" width="660" height="212" as="geometry"/></mxCell><mxCell id="v3a_criRisk" value="Ловушки протокола: прямоугольные пачки на проверке · FFT только в fp32 · λ-разминка ВЧ-лосса · аугментация строго симметрична по рукам · метрики смотреть ПОСЛЕ досчёта всех сидов · короткие пробы годятся только для проверки кода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;dashed=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;arcSize=6;" vertex="1" parent="v3a_crit"><mxGeometry x="15" y="254" width="660" height="36" as="geometry"/></mxCell><mxCell id="v3a_hflane" value="Компонент 3 · ВЧ-supervision локализации (поток обучения, только рука с блоком)&lt;br&gt;GT-рамки уровня P3 → маска периметров (расширение 1 px, downsampling до размера карты)&lt;br&gt;признак ветки box-regression P3 → фиксированный лапласиан 3×3 ≈ ВЧ-полоса&lt;br&gt;L_aux = L1( HF(признак), маска_границ ), вес λ: разминка 0 → 0.05 за первые 20 эпох (частотный принцип)&lt;br&gt;λ = 0 — битовая идентичность контролю; свободная ниша: опубликованной схемы частотной развязки + supervised локализации поиском не найдено&lt;br&gt;мишень: строгое AP (границы рамок)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8;" vertex="1" parent="v3a_1"><mxGeometry x="40" y="1196" width="1010" height="150" as="geometry"/></mxCell><mxCell id="v3a_stagesT" value="Карта этапов реализации — от бесплатного к дорогому" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#7a2430;" vertex="1" parent="v3a_1"><mxGeometry x="1090" y="1196" width="660" height="20" as="geometry"/></mxCell><mxCell id="v3a_stA" value="A · 1–2 дня, 0 GPU·ч&lt;br&gt;score-fusion на готовом кэше,&lt;br&gt;mMOTA/mIDF1, скрипт зеркальной пары" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=9;arcSize=10;" vertex="1" parent="v3a_1"><mxGeometry x="1090" y="1224" width="320" height="58" as="geometry"/></mxCell><mxCell id="v3a_stB" value="B·C·D · 2–4 нед кода, обкатки ~20 ч&lt;br&gt;операторы шеи ∥ миксер амплитуд ∥ ВЧ-лосс,&lt;br&gt;каждый с приёмкой и лимитом починок = 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=9;arcSize=10;" vertex="1" parent="v3a_1"><mxGeometry x="1428" y="1224" width="330" height="58" as="geometry"/></mxCell><mxCell id="v3a_stAB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;" edge="1" parent="v3a_1" source="v3a_stA" target="v3a_stB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3a_stF" value="F · решающая серия ≈ 162 GPU·ч&lt;br&gt;2 руки × 3 сида × ~27 ч, полный стек,&lt;br&gt;пороги из панели протокола выше&lt;br&gt;пары по сидам: 42 → гейт → 123 → 2024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=9;arcSize=10;fontStyle=1;" vertex="1" parent="v3a_1"><mxGeometry x="1428" y="1292" width="330" height="66" as="geometry"/></mxCell><mxCell id="v3a_stBF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#d79b00;" edge="1" parent="v3a_1" source="v3a_stB" target="v3a_stF"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6. DRB v3 — этапы, файлы, риски" id="page-v3-plan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="v3b_0"/><mxCell id="v3b_1" parent="0"/><mxCell id="v3b_t" value="DRB v3 — план реализации: шаги, приёмка, файлы, риски" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="14" width="1740" height="30" as="geometry"/></mxCell><mxCell id="v3b_s" value="Полная версия с формулами — ПЛАН_DRB_v3.md в корне репозитория · приёмка каждого этапа обязательна до перехода к следующему" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="50" width="1740" height="24" as="geometry"/></mxCell><mxCell id="v3b_gate" value="ГЕЙТЫ МЕЖДУ СЕРИЯМИ — ТОЛЬКО СЛУЖЕБНЫЕ (едет ли обучение, пишутся ли α-логи, попадает ли обкатка в ±0.02 от известного контроля). Метрики раскрываются только когда ВСЕ сиды обеих рук досчитаны." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;dashed=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="82" width="1730" height="40" as="geometry"/></mxCell><mxCell id="v3b_A" value="ЭТАП A · Замеры без обучения — 1–2 дня, 0 GPU·ч&lt;br&gt;&lt;br&gt;• rescore_with_q: s′ = σ(a·logit(s) + b·z(q_rank)) — логистическая регрессия на val-split, никогда на тесте&lt;br&gt;• evaluation/tracking_metrics.py: per-class MOTA/IDF1 + классоусреднённое (mMOTA/mIDF1), пересчёт старых прогонов&lt;br&gt;• run_mirror_pair: одна команда «сид → обучение → оценка → строка в таблице»&lt;br&gt;✓ ПРИЁМКА: старые числа воспроизводятся; ΔAP50 ночи зафиксирован в хронике (или честный ноль)&lt;br&gt;✗ Риск практически нулевой — процедура детерминирована" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="138" width="850" height="280" as="geometry"/></mxCell><mxCell id="v3b_B" value="ЭТАП B · Частотные операторы шеи — ядро, 1–2 недели кода + обкатка 12 эп (~7 ч)&lt;br&gt;&lt;br&gt;• models/neck_v3/freq_upsample.py + hf_enhance.py — модули из плана B1&lt;br&gt;• вставка паттерном DRBWrappedLayer / DRBTrainer.get_model (models/yolo_neck/neck_drb.py); индексы head.f [16,19,22] читаются динамически&lt;br&gt;• конфиг drb_v3.yaml = побайтовая копия baseline.yaml + вставка — зеркальность гарантирована сборкой&lt;br&gt;• тесты: 4 формы карт (ловушка прямоугольных пачек); g=0 ⇒ битовая идентичность чистой шее&lt;br&gt;• замер: инференс ≤ baseline + 3 мс; параметры блока меньше 50k; ≥ 30 к/с&lt;br&gt;✓ ПРИЁМКА обкатки: α-логи пишутся, loss без NaN, mAP50@12эп в ±0.02 от 0.4254&lt;br&gt;✗ лимит циклов починки = 2, дальше переработка конструкции B1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="910" y="138" width="860" height="280" as="geometry"/></mxCell><mxCell id="v3b_C" value="ЭТАП C · Амплитудная аугментация — параллельно с B, 3–5 дней + обкатка обеих рук&lt;br&gt;&lt;br&gt;• augment_amp_swap.py: p=0.5, β~U(0.3,0.7), rfft2 в fp32 (паттерн fga.py), партнёр из чужого поднабора w.p. 0.7&lt;br&gt;• автономный модуль подключается ОДИНАКОВО флагом в train_baseline и train_drb — условие зеркальности&lt;br&gt;• ГИСТОГРАММЫ ДО ОБУЧЕНИЯ: заполнен ли промежуток день↔ночь в дескрипторах; нет — крутить β, обучение не запускать&lt;br&gt;• обкатка: контроль с аугментацией не проседает более чем на 0.03 от 0.4254&lt;br&gt;✓ дальше аугментация фиксируется навсегда в обоих основных конфигах" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="446" width="850" height="260" as="geometry"/></mxCell><mxCell id="v3b_D" value="ЭТАП D · ВЧ-supervision локализации — поверх B, 5–7 дней · СВОБОДНАЯ НИША НОВИЗНЫ&lt;br&gt;&lt;br&gt;• цель — маска периметров GT-рамок уровня P3 (периметр, расширение 1 px, downsampling)&lt;br&gt;• предсказание — высокая полоса box-признака P3: фиксированный лапласиан 3×3&lt;br&gt;• L_aux = L1(HF(признак), маска) · λ-разминка 0 → 0.05 за 20 эпох (частотный принцип)&lt;br&gt;• точка вмешательства — свой loss-класс поверх DetectionLoss в тренере (приём как get_model)&lt;br&gt;• тесты: идеальное предсказание ⇒ лос = 0; градиент доходит; λ=0 ⇒ битовая идентичность контролю&lt;br&gt;✗ запасной путь: расходимость лосов → λ↓ вдвое; максимум — убрать D: пороги считаются по B+C честно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="910" y="446" width="860" height="260" as="geometry"/></mxCell><mxCell id="v3b_E" value="ЭТАП E · Карта качества наружу — дни, БЕЗ обучения детектора&lt;br&gt;&lt;br&gt;• ② Калман: гибрид достоверности ŝ = mix(conf, rank q_min) → R ∝ max(1−ŝ, 0.05); точки update уже прокидывают kwargs (tracking/lqa_guided_tracker.py:60–63)&lt;br&gt;• режимы off / conf-only / conf+q — готовая абляционная таблица для текста&lt;br&gt;• ③ TTA-кондиционер опционален и ставится последним: BN-статистики по TTN-схеме (разделение источник/цель), сила ∝ доле низкодостоверных областей&lt;br&gt;• опубликованный эффект направления: UTrack даёт AssA +5.4 — величина выше любого межсидового разброса проекта&lt;br&gt;✓ ПРИЁМКА: каждая из процедур оценивается за часы на фиксированных чекпойнтах" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="734" width="850" height="280" as="geometry"/></mxCell><mxCell id="v3b_F" value="ЭТАП F · Решающая серия ≈ 162 GPU·ч (2 руки × 3 сида × ~27 ч)&lt;br&gt;&lt;br&gt;• порядок: пара сида 42 (54 ч) → служебный гейт → пары сидов 123 и 2024&lt;br&gt;• полный стек = B+C+D+E1+E2; различие рук ровно одно — наличие компонентов метода&lt;br&gt;• оценка каждой руки одним скриптом этапа A: AP50 и строгое AP — ОТДЕЛЬНЫЕ строки (усреднение маскирует противоположные эффекты!), трекинг mMOTA/mIDF1 классоусреднённо&lt;br&gt;• отчёт experiments/results/v3_final_seedN.csv + сводка; сравнение по порогам панели протокола стр. 5&lt;br&gt;• хроника обновляется после КАЖДОГО крупного шага (паттерн репозитория)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="910" y="734" width="860" height="280" as="geometry"/></mxCell><mxCell id="v3b_files" value="Карта затрагиваемых файлов&lt;br&gt;операторы шеи — models/neck_v3/* (новое), паттерн models/yolo_neck/neck_drb.py&lt;br&gt;аугментация — training/augment_amp_swap.py (новое), train_baseline.py + train_drb.py (общий флаг)&lt;br&gt;ВЧ-лосс — свой loss-класс в тренере (training/trainer_utils.py рядом с DRBTrainer)&lt;br&gt;score fusion — scripts/rescore_with_q.py (новое), кэш runs/det_cache_q&lt;br&gt;трекер — tracking/lqa_guided_tracker.py · оценка — evaluation/detection_metrics.py, tracking_metrics.py&lt;br&gt;конфиги — training/configs/{drb_v3,baseline}.yaml зеркальная пара · тесты — tests/test_drb.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="40" y="1046" width="1070" height="160" as="geometry"/></mxCell><mxCell id="v3b_risks" value="Риски и запасные пути&lt;br&gt;операторы ломают маршрутизацию → стадийная вставка: сперва FreqUp, затем HF&lt;br&gt;аугментация агрессивна (−0.03 обкатки) → β=0.5/0.5, p↓ до 0.3&lt;br&gt;ВЧ-лос конфликтует → λ↓ вдвое; максимум исключить D — пороги честно по B+C&lt;br&gt;score fusion не даёт прироста → оставить как абляцию, ставку держат B и E&lt;br&gt;GPU занята другими прогонами → длинные серии блоками, короткие ночами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="v3b_1"><mxGeometry x="1130" y="1046" width="640" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
          </mxCell>
        </object>
        <object id="legend2" label="&lt;b&gt;III ПОДТВЕРЖДЁННОЕ УЛУЧШЕНИЕ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Толстая зелёная стрелка ведёт к проверенной замене. Внутри указаны контроль, выборка и доверительный интервал." module_status="good" source="">
          <mxCell parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DDF3E3;strokeColor=#117A46;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=24;fontColor=#182B40;dashed=0;">
            <mxGeometry x="4500" y="230" width="2080" height="200" as="geometry" />

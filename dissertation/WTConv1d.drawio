<mxfile host="app.diagrams.net" type="device" agent="claude-code">
<diagram name="1. Весь конвейер: где что стоит" id="w1">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t1" value="Куда встраивается WTConv1d — весь путь от кадра до метрики" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1a4a72;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="32" as="geometry"/></mxCell>
<mxCell id="t1s" value="Главное, что надо прочитать с этой страницы: YOLO26 и WTConv1d стоят в РАЗНЫХ местах и не спорят друг с другом. YOLO отвечает за вопрос «где объекты на этом кадре», WTConv1d — за вопрос «где объект окажется, пока его не видно»." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="24" as="geometry"/></mxCell>

<mxCell id="btbg" value="&lt;b&gt;ByteTrack — сшивание детекций в траектории&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;tracking/offline_association.py + ultralytics 8.4.84 · работает на процессоре, секунды на видео&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#6c8ebf;strokeWidth=3;align=center;verticalAlign=top;spacingTop=6;fontSize=15;fontStyle=1;arcSize=4;fontColor=#1a4a72;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="700" height="480" as="geometry"/></mxCell>

<mxCell id="vid" value="&lt;b&gt;КАДРЫ ВИДЕО&lt;/b&gt;&lt;br&gt;&lt;br&gt;data/bdd100k/images/track/val&lt;br&gt;&lt;br&gt;200 записей, около 200 кадров&lt;br&gt;в каждой, частота разметки&lt;br&gt;5.05 кадра в секунду" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="140" as="geometry"/></mxCell>

<mxCell id="yolo" value="&lt;b&gt;YOLO26 — ДЕТЕКТОР&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;runs/baseline/seed42,123,2024&lt;/span&gt;&lt;br&gt;&lt;br&gt;Смотрит на ОДИН кадр и отвечает,&lt;br&gt;где на нём объекты и насколько&lt;br&gt;модель в этом уверена.&lt;br&gt;&lt;br&gt;О предыдущих кадрах не знает&lt;br&gt;ничего — памяти у него нет.&lt;br&gt;&lt;br&gt;&lt;b&gt;В этой ветке НЕ МЕНЯЕТСЯ.&lt;/b&gt;&lt;br&gt;Три обученных сида по 100 эпох&lt;br&gt;остаются как есть и служат&lt;br&gt;общей основой сравнения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="245" y="120" width="230" height="230" as="geometry"/></mxCell>

<mxCell id="det" value="&lt;b&gt;ДЕТЕКЦИИ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;runs/det_cache_ctl/val/*.npz&lt;/span&gt;&lt;br&gt;&lt;br&gt;рамка (x1,y1,x2,y2),&lt;br&gt;уверенность, класс,&lt;br&gt;номер кадра&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;посчитаны один раз и лежат&lt;br&gt;в кэше: детектор больше&lt;br&gt;гонять не надо&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2e5;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="160" height="180" as="geometry"/></mxCell>

<mxCell id="bt1" value="&lt;b&gt;1. ПРЕДСКАЗАТЬ, где трек сейчас&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;метод multi_predict&lt;/span&gt;&lt;br&gt;&lt;br&gt;Каждому уже существующему треку&lt;br&gt;надо назвать место на новом кадре&lt;br&gt;ДО того, как посмотрели детекции.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#b85450&quot;&gt;ЭТО И ЕСТЬ ЕДИНСТВЕННАЯ ТОЧКА,&lt;br&gt;КУДА ВСТАВЛЯЕТСЯ WTConv1d&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="150" width="320" height="150" as="geometry"/></mxCell>

<mxCell id="bt2" value="&lt;b&gt;2. СОПОСТАВИТЬ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Предсказанные места сравниваются&lt;br&gt;с рамками детекций по площади&lt;br&gt;пересечения (IoU).&lt;br&gt;&lt;br&gt;Совпало — это тот же объект,&lt;br&gt;личность трека сохраняется.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;чем хуже предсказание, тем чаще&lt;br&gt;совпадения не находится&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="310" height="150" as="geometry"/></mxCell>

<mxCell id="bt3" value="&lt;b&gt;3. ОБНОВИТЬ состояние трека&lt;/b&gt;&lt;br&gt;&lt;br&gt;Совпавшая детекция уточняет,&lt;br&gt;где объект и с какой скоростью&lt;br&gt;он движется." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="330" width="310" height="110" as="geometry"/></mxCell>

<mxCell id="bt4" value="&lt;b&gt;4. РАЗРЫВ: детекции нет&lt;/b&gt;&lt;br&gt;&lt;br&gt;Объект закрыт другой машиной, ушёл&lt;br&gt;в тень или детектор его не увидел.&lt;br&gt;Трек живёт ОДНИМ ПРЕДСКАЗАНИЕМ&lt;br&gt;до 30 кадров (track_buffer).&lt;br&gt;&lt;br&gt;&lt;b&gt;Здесь качество предсказания решает,&lt;br&gt;узнают объект потом или заведут ему&lt;br&gt;новую личность (это и есть потеря).&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="330" width="320" height="160" as="geometry"/></mxCell>

<mxCell id="btn" value="&lt;b&gt;Что в этой ветке НЕ трогается:&lt;/b&gt; пороги уверенности, порог IoU, длина буфера, сам порядок шагов 1-2-3. Меняется ровно одно — чем заполняется шаг 1. Иначе выигрыш нельзя было бы приписать предсказанию." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fe;strokeColor=#9db8d9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="710" y="500" width="660" height="60" as="geometry"/></mxCell>

<mxCell id="out" value="&lt;b&gt;ТРАЕКТОРИИ&lt;/b&gt;&lt;br&gt;&lt;br&gt;у каждого объекта&lt;br&gt;свой номер,&lt;br&gt;протянутый&lt;br&gt;через видео" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1450" y="150" width="170" height="140" as="geometry"/></mxCell>

<mxCell id="ev" value="&lt;b&gt;ОЦЕНКА&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;официальные инструменты BDD100K&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;IDF1&lt;/b&gt; — насколько объекту удалось&lt;br&gt;сохранить ОДНУ личность (главная&lt;br&gt;метрика этой ветки)&lt;br&gt;&lt;br&gt;MOTA — сколько объектов вообще&lt;br&gt;найдено (за неё отвечает YOLO)&lt;br&gt;&lt;br&gt;IDSw — сколько раз личность&lt;br&gt;перепутана&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#b85450&quot;&gt;HOTA/AssA этот конвейер не отдаёт&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1450" y="320" width="200" height="260" as="geometry"/></mxCell>

<mxCell id="sockbg" value="&lt;b&gt;ЧТО МОЖНО ВСТАВИТЬ В ШАГ 1 — три варианта на одном стенде&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d79b00;strokeWidth=3;dashed=1;align=center;verticalAlign=top;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="690" y="630" width="960" height="330" as="geometry"/></mxCell>

<mxCell id="kal" value="&lt;b&gt;А. ФИЛЬТР КАЛМАНА&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;как сейчас · база сравнения&lt;/span&gt;&lt;br&gt;&lt;br&gt;Считает, что объект движется&lt;br&gt;РАВНОМЕРНО И ПРЯМО: взял&lt;br&gt;последнюю скорость и продолжил.&lt;br&gt;&lt;br&gt;Обучаемых частей нет.&lt;br&gt;&lt;br&gt;&lt;b&gt;Слабое место:&lt;/b&gt; машина повернула —&lt;br&gt;фильтр об этом не знает. Поэтому&lt;br&gt;на длинных разрывах ошибка растёт&lt;br&gt;быстрее всего.&lt;br&gt;&lt;br&gt;&lt;b&gt;IDF1 = 51.0&lt;/b&gt; (50 видео)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="680" width="290" height="260" as="geometry"/></mxCell>

<mxCell id="wt" value="&lt;b style=&quot;color:#7a2430&quot;&gt;Б. WTConv1d — ЭТО И ЕСТЬ РАБОТА&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;обучаемая модель движения&lt;/span&gt;&lt;br&gt;&lt;br&gt;Смотрит на последние 12 положений&lt;br&gt;трека и предсказывает, где объект&lt;br&gt;окажется через k кадров.&lt;br&gt;&lt;br&gt;&lt;b&gt;Разметку НЕ видит&lt;/b&gt; — только прошлое&lt;br&gt;самого трека, как и Калман.&lt;br&gt;Поэтому работает на любом видео.&lt;br&gt;&lt;br&gt;Обучается заранее на траекториях&lt;br&gt;train-сплита (1400 видео).&lt;br&gt;&lt;br&gt;&lt;b&gt;IDF1 = ?&lt;/b&gt; — это и предстоит узнать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="300" height="260" as="geometry"/></mxCell>

<mxCell id="orc" value="&lt;b&gt;В. ОРАКУЛ — ЭТО ЛИНЕЙКА,&lt;br&gt;А НЕ МЕТОД&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;уже выполнено 07.09&lt;/span&gt;&lt;br&gt;&lt;br&gt;В разрывах подставляется ИСТИННОЕ&lt;br&gt;положение из разметки.&lt;br&gt;&lt;br&gt;&lt;b&gt;В реальной работе невозможен:&lt;/b&gt;&lt;br&gt;на новом видео разметки нет.&lt;br&gt;Нужен был ровно один раз — узнать,&lt;br&gt;сколько вообще стоит хорошее&lt;br&gt;предсказание.&lt;br&gt;&lt;br&gt;&lt;b&gt;IDF1 = 59.0, то есть +8.0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;это 100% доступного запаса&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1340" y="680" width="290" height="260" as="geometry"/></mxCell>

<mxCell id="lg1" value="&lt;b&gt;Как читать эту страницу&lt;/b&gt;&lt;br&gt;&lt;br&gt;◆ зелёное — детектор, в этой ветке не меняется&lt;br&gt;◆ синее — трекер и его метрики, механика не меняется&lt;br&gt;◆ оранжевое — единственная точка вмешательства&lt;br&gt;◆ розовое — то, что предстоит построить&lt;br&gt;◆ жёлтое — уже измеренное число&lt;br&gt;&lt;br&gt;Стрелки — поток данных слева направо: кадр, детекции,&lt;br&gt;сшивание в траектории, метрика." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="380" height="200" as="geometry"/></mxCell>

<mxCell id="nb1" value="&lt;b&gt;Почему детектор и предсказатель не спорят&lt;/b&gt;&lt;br&gt;&lt;br&gt;YOLO26 отвечает на вопрос «что видно ЗДЕСЬ И СЕЙЧАС».&lt;br&gt;WTConv1d отвечает на вопрос «что происходит, ПОКА НЕ ВИДНО».&lt;br&gt;&lt;br&gt;Это разные вопросы к разным данным: у детектора на входе&lt;br&gt;картинка, у предсказателя — числовой ряд из координат.&lt;br&gt;Поэтому обученные детекторы остаются в силе, а ветка&lt;br&gt;предсказания считается на процессоре за минуты.&lt;br&gt;&lt;br&gt;&lt;b&gt;Измеренная граница:&lt;/b&gt; шум детектора 1.9 px, ошибка&lt;br&gt;предсказания 6.5-12.7 px. Основная беда — не в рамках." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="380" height="210" as="geometry"/></mxCell>

<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="vid" target="yolo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="yolo" target="det"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="det" target="bt1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="bt1" target="bt2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="bt2" target="bt3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="совпадения нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;fontSize=10;" edge="1" parent="1" source="bt2" target="bt4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="следующий кадр" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bt4" target="bt1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="bt3" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="out" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="подставляется одно из трёх" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=3;endArrow=block;dashed=1;fontSize=11;fontStyle=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wt" target="bt1"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

<diagram name="2. Что внутри WTConv1d" id="w2">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t2" value="Что внутри предсказателя: от 12 точек трека до положения через k кадров" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="32" as="geometry"/></mxCell>
<mxCell id="t2s" value="Белое — устройство слоя по авторскому коду wtconv/wtconv1d.py (лицензия MIT). Розовое — то, что дописывается вокруг него. Жёлтое — числа, уже измеренные в гейте Б." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="24" as="geometry"/></mxCell>

<mxCell id="in2" value="&lt;b&gt;ВХОД: кусок траектории&lt;/b&gt;&lt;br&gt;&lt;br&gt;12 последних положений&lt;br&gt;центра рамки трека&lt;br&gt;&lt;br&gt;два числовых ряда:&lt;br&gt;x по кадрам и y по кадрам&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;это НЕ картинка — это ряд чисел,&lt;br&gt;поэтому и слой одномерный&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="190" as="geometry"/></mxCell>

<mxCell id="lay" value="&lt;b&gt;СЛОЙ WTConv1d — авторский код, берётся как есть&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;WTConv1d(channels, channels, kernel_size=5, wt_levels=L, wt_type=&#39;db1&#39;) · требует, чтобы число входных и выходных каналов совпадало&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;strokeWidth=3;align=center;verticalAlign=top;spacingTop=6;fontSize=15;fontStyle=1;arcSize=3;fontColor=#1a4a72;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="1080" height="470" as="geometry"/></mxCell>

<mxCell id="s1" value="&lt;b&gt;1. РАЗЛОЖЕНИЕ ПО ПОЛОСАМ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ряд разделяется на две части:&lt;br&gt;плавную (куда объект едет вообще)&lt;br&gt;и мелкую (дрожание и шум рамки).&lt;br&gt;&lt;br&gt;Плавная часть делится снова —&lt;br&gt;и так L раз (wt_levels).&lt;br&gt;&lt;br&gt;&lt;b&gt;Зачем:&lt;/b&gt; за L шагов слой видит&lt;br&gt;участок ряда длиной порядка 2^L,&lt;br&gt;а параметров тратит как на&lt;br&gt;маленькое окно. Это и есть&lt;br&gt;«большое поле задёшево».&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;фильтры строятся через pywt,&lt;br&gt;сами НЕ обучаются&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="250" height="290" as="geometry"/></mxCell>

<mxCell id="s2" value="&lt;b&gt;2. СВОЯ СВЁРТКА НА КАЖДУЮ ПОЛОСУ&lt;/b&gt;&lt;br&gt;&lt;br&gt;На каждом уровне у плавной и&lt;br&gt;мелкой части СВОИ обучаемые&lt;br&gt;коэффициенты (kernel_size=5).&lt;br&gt;&lt;br&gt;&lt;b&gt;Вот это и есть обучение:&lt;/b&gt; модель&lt;br&gt;сама решает, что делать с каждой&lt;br&gt;полосой — усилить, ослабить,&lt;br&gt;сдвинуть.&lt;br&gt;&lt;br&gt;&lt;b&gt;Отличие от того, что мы делали&lt;br&gt;в гейте Б:&lt;/b&gt; там мелкая полоса&lt;br&gt;просто обнулялась вручную,&lt;br&gt;одинаково для всех треков.&lt;br&gt;Здесь решение обучается." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="250" height="290" as="geometry"/></mxCell>

<mxCell id="s3" value="&lt;b&gt;3. МАСШТАБ НА ПОЛОСУ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Обучаемый множитель у каждой&lt;br&gt;полосы, стартует с 0.1.&lt;br&gt;&lt;br&gt;Слой начинает работу почти как&lt;br&gt;обычная свёртка и добавляет&lt;br&gt;вейвлетную часть постепенно.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#b85450&quot;&gt;в истории DRB ровно здесь была&lt;br&gt;поломка: ветвь входила со своим&lt;br&gt;масштабом и глушила основную.&lt;br&gt;У авторов это решено и проверено&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="170" width="240" height="290" as="geometry"/></mxCell>

<mxCell id="s4" value="&lt;b&gt;4. СБОРКА ОБРАТНО&lt;/b&gt;&lt;br&gt;&lt;br&gt;Полосы складываются обратно&lt;br&gt;в один ряд той же длины.&lt;br&gt;&lt;br&gt;Параллельно идёт обычная&lt;br&gt;свёртка по исходному ряду,&lt;br&gt;и два результата складываются.&lt;br&gt;&lt;br&gt;&lt;b&gt;Смысл:&lt;/b&gt; если вейвлетная часть&lt;br&gt;окажется бесполезной, модель&lt;br&gt;может свести её к нулю и&lt;br&gt;остаться обычной свёрткой.&lt;br&gt;Хуже базы стать трудно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="170" width="240" height="290" as="geometry"/></mxCell>

<mxCell id="basis" value="&lt;b&gt;wt_type — выбор базиса, одна строка в коде&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#39;db1&#39; = Хаар (по умолчанию у авторов) · &#39;db2&#39;, &#39;db3&#39;, &#39;coif1&#39; — любые из pywt&lt;br&gt;&lt;br&gt;&lt;b&gt;Измерено у нас на траекториях (гейт Б, 50 видео):&lt;/b&gt; Хаар — ХУДШИЙ из всех (−6.5%), лучший db3 (+1.1%).&lt;br&gt;&lt;b&gt;Измерено у авторов на изображениях (ECCV 2024, табл. 8):&lt;/b&gt; Хаар — ЛУЧШИЙ (81.75), db2 — 81.68, db3 — 81.56.&lt;br&gt;&lt;br&gt;Порядок обратный, и это не противоречие: домены разные. Отсюда защитимый вопрос работы — не «поменяем базис наугад»,&lt;br&gt;а «на временных рядах траекторий оптимум базиса другой, чем на изображениях, и вот измерение»." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="1040" height="90" as="geometry"/></mxCell>

<mxCell id="head" value="&lt;b&gt;ГОЛОВА ПРЕДСКАЗАНИЯ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;дописывается нами&lt;/span&gt;&lt;br&gt;&lt;br&gt;Берёт выход слоя и выдаёт&lt;br&gt;два числа: где окажется&lt;br&gt;центр объекта через k кадров.&lt;br&gt;&lt;br&gt;Обучается на разрывах&lt;br&gt;длиной 2, 3 и 5 кадров —&lt;br&gt;тех же, что в гейте Б." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="230" height="220" as="geometry"/></mxCell>

<mxCell id="out2" value="&lt;b&gt;ВЫХОД&lt;/b&gt;&lt;br&gt;&lt;br&gt;предсказанное положение (x, y)&lt;br&gt;→ уходит в шаг 1 трекера&lt;br&gt;со страницы 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=center;verticalAlign=middle;fontSize=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="230" height="120" as="geometry"/></mxCell>

<mxCell id="tr" value="&lt;b&gt;ОБУЧЕНИЕ — где берутся примеры&lt;/b&gt;&lt;br&gt;&lt;br&gt;Разметка train-сплита: &lt;b&gt;1400 видео&lt;/b&gt; (data/bdd100k/labels/box_track_20/train).&lt;br&gt;Из каждого трека нарезаются куски подряд идущих кадров: 12 на вход, положение через k кадров — ответ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Посчитано по выборке из 40 видео:&lt;/b&gt; 4363 непрерывных куска, из них 1504 длиной 17 кадров и больше.&lt;br&gt;В пересчёте на весь сплит — около &lt;b&gt;50 тысяч обучающих последовательностей&lt;/b&gt;. Для такой маленькой модели достаточно.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ограничение, которое надо назвать самим:&lt;/b&gt; медиана непрерывного куска — 11 кадров при частоте 5 кадров в секунду.&lt;br&gt;Контекста у модели мало. Именно здесь 30 кадров в секунду были бы полезны — но как ДЛИНА ПРИМЕРОВ, а не как&lt;br&gt;полоса дрожания: полосу проверили по гироскопу 50 Гц, её нет (гейт В)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="900" height="220" as="geometry"/></mxCell>

<mxCell id="risk2" value="&lt;b style=&quot;color:#7a2430&quot;&gt;Главный риск этой конструкции&lt;/b&gt;&lt;br&gt;&lt;br&gt;Фильтр Калмана на равномерном движении&lt;br&gt;математически оптимален. Обучаемая модель&lt;br&gt;вполне может просто выучить ту же прямую&lt;br&gt;и сравняться с ним.&lt;br&gt;&lt;br&gt;&lt;b&gt;Где искать выигрыш (из гейта Б):&lt;/b&gt;&lt;br&gt;разрыв 2-3 кадра — ошибка от шума рамки,&lt;br&gt;там уже почти всё выбрано;&lt;br&gt;&lt;b&gt;разрыв 5 кадров — ошибка от МОДЕЛИ&lt;br&gt;ДВИЖЕНИЯ&lt;/b&gt; (машина повернула).&lt;br&gt;&lt;br&gt;Целиться надо в длинные разрывы." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="980" y="620" width="380" height="220" as="geometry"/></mxCell>

<mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="in2" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s4" target="head"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="head" target="out2"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

<diagram name="3. Линейка: сколько это стоит" id="w3">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t3" value="Линейка гейта А: во что превращается улучшение предсказания" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#7a2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="32" as="geometry"/></mxCell>
<mxCell id="t3s" value="Все числа сняты 07.09 на 50 видео val, кэш детекций один и тот же, менялось только предсказание. Скрипт scripts/tracker_gate_a.py, таблица experiments/results/gate_a_oracle.csv." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="24" as="geometry"/></mxCell>

<mxCell id="sc" value="&lt;b&gt;ШКАЛА: насколько точнее предсказание → сколько пунктов IDF1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;strokeWidth=3;align=center;verticalAlign=top;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="500" as="geometry"/></mxCell>

<mxCell id="r0" value="&lt;b&gt;база: фильтр Калмана как есть&lt;/b&gt;   —   IDF1 = 51.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="r2" value="ошибка предсказания меньше на &lt;b&gt;2%&lt;/b&gt;   →   &lt;b&gt;+0.09&lt;/b&gt; IDF1        &lt;span style=&quot;color:#b85450&quot;&gt;◄ сюда попало ручное вейвлетное очищение из гейта Б&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8ea;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="216" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="r5" value="меньше на &lt;b&gt;5%&lt;/b&gt;   →   &lt;b&gt;+0.23&lt;/b&gt; IDF1        &lt;span style=&quot;color:#777&quot;&gt;неотличимо от шума&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#d99694;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="272" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="r10" value="меньше на &lt;b&gt;10%&lt;/b&gt;   →   &lt;b&gt;+0.84&lt;/b&gt; IDF1        &lt;span style=&quot;color:#777&quot;&gt;нижняя граница осмысленного&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="328" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="r25" value="меньше на &lt;b&gt;25%&lt;/b&gt;   →   &lt;b&gt;+2.46&lt;/b&gt; IDF1        &lt;span style=&quot;color:#3a7d44&quot;&gt;◄ цель, ради которой стоит работать&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="384" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="r50" value="меньше на &lt;b&gt;50%&lt;/b&gt;   →   &lt;b&gt;+6.11&lt;/b&gt; IDF1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="r100" value="&lt;b&gt;предсказание безошибочно (оракул, в жизни недостижим)&lt;/b&gt;   →   &lt;b&gt;+8.01&lt;/b&gt; IDF1, то есть 51.0 → 59.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="496" width="840" height="46" as="geometry"/></mxCell>
<mxCell id="rnote" value="Отдача НЕЛИНЕЙНА: первые проценты почти ничего не дают, полезное начинается с четверти. Поэтому «стало лучше на 2%» — это не маленький успех, это ноль." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#7a2430;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="552" width="840" height="40" as="geometry"/></mxCell>

<mxCell id="crit" value="&lt;b&gt;КРИТЕРИИ, ЗАПИСАННЫЕ ЗАРАНЕЕ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;чтобы не подгонять оценку под результат задним числом — так уже было в истории DRB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="640" height="500" as="geometry"/></mxCell>

<mxCell id="c1" value="&lt;b&gt;ГЕЙТ 1 — офлайн, без трекера (часы счёта)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Обученная модель сравнивается с Калманом на тех же&lt;br&gt;окнах и разрывах, что в гейте Б, с тем же парным&lt;br&gt;бутстрапом по видео.&lt;br&gt;&lt;br&gt;&lt;b&gt;Проходит, если:&lt;/b&gt; ошибка на разрыве 5 кадров ниже&lt;br&gt;Калмана не менее чем на &lt;b&gt;15%&lt;/b&gt;, и доверительный&lt;br&gt;интервал не накрывает ноль.&lt;br&gt;&lt;br&gt;&lt;b&gt;Не проходит →&lt;/b&gt; ветка закрывается за день, а не за месяц." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1010" y="170" width="580" height="180" as="geometry"/></mxCell>

<mxCell id="c2" value="&lt;b&gt;ГЕЙТ 2 — в трекере (десятки минут)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Модель подставляется в ту же точку, где стоял оракул.&lt;br&gt;Те же 50 видео, те же пороги, тот же кэш детекций.&lt;br&gt;&lt;br&gt;&lt;b&gt;Смотрим два числа:&lt;/b&gt;&lt;br&gt;— прирост IDF1 к Калману (есть ли польза);&lt;br&gt;— доля от +8.01 (какую часть запаса забрали).&lt;br&gt;&lt;br&gt;&lt;b&gt;Заранее честно:&lt;/b&gt; MOTA почти не сдвинется. Пропусков&lt;br&gt;обнаружения примерно в 14 раз больше, чем перебросов&lt;br&gt;личности, и это надо сказать во введении самим." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1010" y="370" width="580" height="210" as="geometry"/></mxCell>

<mxCell id="ctx" value="&lt;b&gt;Откуда взялась именно эта линейка&lt;/b&gt;&lt;br&gt;&lt;br&gt;Гейт А ставился так: в трекер подставлялось истинное положение из разметки — сначала полностью, потом частично&lt;br&gt;(на 2%, 5%, 10%, 25%, 50% пути к истине). Получилась кривая «точность предсказания → метрика», и она переводит&lt;br&gt;проценты в пикселях, о которых спорили в гейте Б, в пункты, о которых спрашивают на защите.&lt;br&gt;&lt;br&gt;&lt;b&gt;Оговорка, которую надо повторять при цитировании:&lt;/b&gt; оракул подменял всю рамку целиком, включая её размер,&lt;br&gt;а предсказатель работает только с центром. Значит +8.01 — граница завышенная, реальный потолок ниже." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1580" height="170" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

<diagram name="4. Порядок работ и файлы" id="w4">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t4" value="Порядок работ: что уже есть, что дописывается, чем это кончается" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1a4a72;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="32" as="geometry"/></mxCell>
<mxCell id="t4s" value="Зелёное — готово и проверено. Розовое — предстоит написать. Серое — берётся у авторов без изменений." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="24" as="geometry"/></mxCell>

<mxCell id="have" value="&lt;b&gt;УЖЕ ГОТОВО И ПРОВЕРЕНО&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f9f1;strokeColor=#82b366;strokeWidth=3;align=center;verticalAlign=top;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;fontColor=#3a7d44;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="580" height="620" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;Детекции YOLO26&lt;/b&gt;&lt;br&gt;runs/det_cache_ctl — 50 видео val, посчитаны один раз.&lt;br&gt;Детектор больше запускать не нужно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="520" height="75" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;Шов в трекере&lt;/b&gt;&lt;br&gt;scripts/tracker_gate_a.py — точка подмены предсказания уже&lt;br&gt;сделана и работает. Обученная модель встаёт туда же, где&lt;br&gt;сейчас стоит оракул, без переделки трекера." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="255" width="520" height="90" as="geometry"/></mxCell>
<mxCell id="h3" value="&lt;b&gt;Стенд офлайн-сравнения&lt;/b&gt;&lt;br&gt;scripts/wavelet_gate_b_dets.py — нарезка окон, разрывы 2/3/5,&lt;br&gt;парный бутстрап по видео. Готов принимать новый предсказатель&lt;br&gt;как ещё один метод в общую таблицу." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="520" height="90" as="geometry"/></mxCell>
<mxCell id="h4" value="&lt;b&gt;Линейка&lt;/b&gt;&lt;br&gt;gate_a_oracle.csv — кривая «точность → IDF1», по которой любой&lt;br&gt;будущий результат сразу переводится в пункты метрики." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="465" width="520" height="75" as="geometry"/></mxCell>
<mxCell id="h5" value="&lt;b&gt;Отчёт по проверкам&lt;/b&gt;&lt;br&gt;dissertation/Wavelet/Wavelet.md — гейты А, Б, В со всеми числами&lt;br&gt;и оговорками. Отсюда берутся формулировки для главы." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="555" width="520" height="75" as="geometry"/></mxCell>
<mxCell id="h6" value="&lt;b&gt;pywt 1.8.0 в .venv&lt;/b&gt; — зависимость слоя уже стоит." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="645" width="520" height="50" as="geometry"/></mxCell>

<mxCell id="todo" value="&lt;b&gt;ПРЕДСТОИТ НАПИСАТЬ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f7;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;fontColor=#7a2430;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="580" height="620" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;1. Загрузчик последовательностей&lt;/b&gt;&lt;br&gt;Нарезка траекторий train-сплита (1400 видео) на пары&lt;br&gt;«12 кадров на вход → положение через k кадров».&lt;br&gt;Отдельно отложить часть видео на проверку — так, чтобы&lt;br&gt;одно видео не попало и в обучение, и в оценку." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="165" width="520" height="105" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;2. Модель&lt;/b&gt;&lt;br&gt;Авторский WTConv1d (файл из репозитория, MIT) плюс своя&lt;br&gt;голова предсказания. Размер маленький — обучение на&lt;br&gt;видеокарте займёт минуты, а не сутки." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="285" width="520" height="90" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b&gt;3. Обучение&lt;/b&gt;&lt;br&gt;Цель — минимум ошибки положения на разрывах 2/3/5 кадров.&lt;br&gt;Обязательный контроль: та же модель, но с обычной свёрткой&lt;br&gt;вместо WTConv1d. Иначе нельзя будет сказать, что выигрыш&lt;br&gt;дал именно вейвлетный слой, а не сам факт обучения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="390" width="520" height="105" as="geometry"/></mxCell>
<mxCell id="d4" value="&lt;b&gt;4. Абляция базисов&lt;/b&gt;&lt;br&gt;Хаар, db2, db3, db4, coif1 — одна строка wt_type на прогон.&lt;br&gt;Это и есть пункт новизны: у авторов на изображениях лучшим&lt;br&gt;оказался Хаар, у нас на траекториях он худший." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="510" width="520" height="90" as="geometry"/></mxCell>
<mxCell id="d5" value="&lt;b&gt;5. Прогон в трекере&lt;/b&gt;&lt;br&gt;Только если гейт 1 пройден. Один вызов уже готового скрипта." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="615" width="520" height="70" as="geometry"/></mxCell>

<mxCell id="ext" value="&lt;b&gt;БЕРЁТСЯ У АВТОРОВ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=3;align=center;verticalAlign=top;spacingTop=8;fontSize=15;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="340" height="620" as="geometry"/></mxCell>
<mxCell id="x1" value="&lt;b&gt;github.com/BGU-CS-VIL/WTConv&lt;/b&gt;&lt;br&gt;лицензия MIT&lt;br&gt;&lt;br&gt;Нужен один файл:&lt;br&gt;&lt;b&gt;wtconv/wtconv1d.py&lt;/b&gt;&lt;br&gt;плюс wtconv/util/wavelet.py&lt;br&gt;(построение фильтров через pywt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1305" y="165" width="290" height="140" as="geometry"/></mxCell>
<mxCell id="x2" value="&lt;b&gt;Что НЕ берём и почему&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;fast_wtconv&lt;/b&gt; — ускоренная версия.&lt;br&gt;Все её ядра написаны под Хаара&lt;br&gt;(cuda_haar, triton_haar).&lt;br&gt;Со сменой базиса она несовместима,&lt;br&gt;а базис — это наш пункт новизны.&lt;br&gt;&lt;br&gt;На таком крошечном ряде выигрыш&lt;br&gt;в скорости всё равно не нужен.&lt;br&gt;&lt;br&gt;&lt;b&gt;wtconv2d&lt;/b&gt; — ветка детектора,&lt;br&gt;отдельная тема, требует полных&lt;br&gt;обучений YOLO по 100 эпох." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1305" y="325" width="290" height="290" as="geometry"/></mxCell>

<mxCell id="fin" value="&lt;b&gt;Чем это кончается в любом случае&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Если гейт 1 не пройден&lt;/b&gt; — ветка закрыта за день, и в работе остаётся измеренный результат: обучаемая модель движения на данных 5 Гц не бьёт фильтр Калмана.&lt;br&gt;Это отрицательный, но защитимый результат с числами, а не потерянный месяц.&lt;br&gt;&lt;br&gt;&lt;b&gt;Если пройден&lt;/b&gt; — есть прирост IDF1, измеренный на настроенном трекере, с абляцией базисов и с верхней границей рядом. Пункт новизны формулируется как перенос вейвлетной свёртки&lt;br&gt;на временной ряд траекторий в многообъектном трекинге плюс измеренный оптимум базиса, отличный от авторского.&lt;br&gt;&lt;br&gt;&lt;b&gt;В обоих случаях&lt;/b&gt; обученные детекторы YOLO26 остаются нетронутыми и продолжают служить основой сравнения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1580" height="200" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
